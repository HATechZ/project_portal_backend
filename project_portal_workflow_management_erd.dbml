Table tenants {
  id uuid [pk, not null]
  name varchar(180) [not null]
  slug varchar(100) [not null, unique]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table users {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  full_name varchar(160) [not null]
  email varchar(255) [not null]
  password_hash varchar(255)
  avatar_url text
  is_active boolean [not null, default: true]
  last_login_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (tenant_id, email) [unique]
    (tenant_id)
  }
}

Table roles {
  id uuid [pk, not null]
  code actor_role_code [not null, unique]
  name varchar(120) [not null]
  description text
  is_system_role boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

Table user_roles {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  user_id uuid [not null]
  role_id uuid [not null]
  assigned_by_user_id uuid
  assigned_at timestamp [not null, default: `now()`]
  revoked_at timestamp

  indexes {
    (user_id, role_id, revoked_at)
    (tenant_id)
  }
}

Table actor_profiles {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  user_id uuid
  role_id uuid [not null]
  member_id uuid
  client_contact_id uuid
  label varchar(180) [not null]
  is_default boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (id, tenant_id) [unique]
    (member_id, tenant_id)
    (client_contact_id, tenant_id)
    (tenant_id)
  }
}

Table auth_sessions {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  user_id uuid [not null]
  refresh_token_hash varchar(255) [not null]
  previous_refresh_token_hash varchar(255)
  ip_address varchar(80)
  user_agent text
  expires_at timestamp [not null]
  absolute_expires_at timestamp [not null]
  revoked_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id)
    (expires_at)
    (previous_refresh_token_hash)
    (tenant_id)
  }
}

Table auth_session_consumed_refresh_tokens {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  session_id uuid [not null]
  token_hash varchar(255) [not null]
  consumed_at timestamp [not null, default: `now()`]

  indexes {
    (tenant_id, token_hash) [unique]
    (session_id)
    (tenant_id)
  }
}

Table password_reset_tokens {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  user_id uuid [not null]
  token_hash varchar(255) [not null]
  expires_at timestamp [not null]
  used_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (tenant_id, token_hash) [unique]
    (user_id)
    (tenant_id)
  }
}

Table company_types {
  id uuid [pk, not null]
  name varchar(100) [not null, unique]
  description text
}

Table companies {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  name varchar(180) [not null]
  abbr varchar(30) [not null]
  company_type_id uuid
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (tenant_id, abbr) [unique]
    (name)
    (tenant_id)
  }
}

Table division_types {
  id uuid [pk, not null]
  name varchar(100) [not null, unique]
  description text
}

Table divisions {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  company_id uuid [not null]
  name varchar(180) [not null]
  abbr varchar(30) [not null]
  division_type_id uuid
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (id, tenant_id) [unique]
    (id, tenant_id, company_id) [unique]
    (tenant_id, company_id, abbr) [unique]
    (company_id, name)
    (tenant_id)
  }
}

Table members {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  user_id uuid
  company_id uuid [not null]
  division_id uuid [not null]
  name varchar(160) [not null]
  email varchar(255) [not null]
  role_title varchar(140) [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (id, tenant_id) [unique]
    (tenant_id, email) [unique]
    (company_id)
    (division_id)
    (division_id, tenant_id, company_id)
    (tenant_id)
  }
}

Table teams {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  company_id uuid [not null]
  division_id uuid [not null]
  name varchar(180) [not null]
  lead_member_id uuid
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (tenant_id, division_id, name) [unique]
    (division_id, tenant_id, company_id)
    (tenant_id)
  }
}

Table team_members {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  team_id uuid [not null]
  member_id uuid [not null]
  team_role varchar(100)
  joined_at timestamp [not null, default: `now()`]
  left_at timestamp

  indexes {
    (team_id, member_id, left_at)
    (tenant_id)
  }
}

Table clients {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  company_id uuid
  name varchar(180) [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (name)
    (tenant_id)
  }
}

Table client_contacts {
  tenant_id uuid [not null]
  id uuid [pk, not null]
  user_id uuid
  client_id uuid [not null]
  name varchar(160) [not null]
  email varchar(255) [not null]
  designation varchar(140)
  phone varchar(60)
  is_primary boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (id, tenant_id) [unique]
    (tenant_id, client_id, email) [unique]
