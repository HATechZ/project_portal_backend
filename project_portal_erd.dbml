Project Project_Portal_Workflow_Management_ERD {
  database_type: "PostgreSQL"
  Note: '''
  Backend-ready 3NF ERD for Project Portal Workflow Management.

  Design principles:
  - BID and PROJECT are handled as one normalized project/workspace table with a workspace type.
  - Work request current status is not stored directly; it is derived from the latest work_request_audit_logs.to_status_id.
  - Project current status is not stored directly; it is derived from the latest project_status_events.to_status_id.
  - Team member arrays, document arrays, final package attachment ids, client revision attachment ids, info request stack, TMS assignments, and revision history are normalized into separate tables.
  - Files are modeled as logical documents + document versions, ready for object storage such as S3, Supabase Storage, MinIO, or local server storage.
  '''
}

/* =========================================================
   ENUMS / DOMAIN CODES
   ========================================================= */

Enum actor_role_code {
  system_admin
  ccr_coordinator
  division_lead
  division_member
  tms_manager
  tms_drawing
  tms_checking
  tms_approval
  client_owner
}

Enum workspace_type_code {
  BID
  PROJECT
}

Enum project_status_code {
  DRAFT
  BIDDING
  ACTIVE
  COMPLETED
  ARCHIVED
}

Enum work_request_status_code {
  CREATED
  DIVISION_NOTIFIED
  INFO_REQUESTED_FROM_MARKETING
  INFO_REQUESTED_FROM_CLIENT
  CLIENT_INFO_PROVIDED
  MARKETING_INFO_PROVIDED
  LEADER_ASSIGNED
  MEMBER_REVIEW
  MEMBER_INFO_REQUESTED
  PM_LEAD_RESPONDED
  PM_MEMBER_SUBMITTED
  PM_REWORK_REQUESTED
  FORWARDED_TO_TMS
  ENGINEERING_REVISION_REQUESTED
  TMS_MEMBER_INFO_REQUESTED
  TMS_ASSIGNED
  DRAWING_IN_PROGRESS
  CHECKING_REVIEW
  APPROVAL_REVIEW
  ENGINEERING_LEAD_REVIEW
  FINAL_SUBMITTED_TO_MARKETING
  FINAL_SUBMITTED_TO_CLIENT
  CLIENT_REVISION_REQUESTED
  RETURNED_TO_DIVISION
  DIVISION_MEMBER_APPROVED
  DIVISION_MANAGER_APPROVED
  FORWARDED_TO_CCR
  HML_LISTED
  REJECTED
}

Enum workflow_action_code {
  ADD_COMPANY
  ADD_DIVISION
  ADD_TEAM
  ADD_MEMBER
  ADD_PROJECT
  ADD_BID
  ADD_CLIENT_DOCUMENT
  ADD_WORK_REQUEST_DOCUMENT
  ADD_WORK_REQUEST
  ADD_WORK_REQUEST_NOTE
  REQUEST_WORKFLOW_INFO
  RESPOND_WORKFLOW_INFO
  REQUEST_INFO_FROM_MARKETING
  MARKETING_RETURN_TO_PM
  MARKETING_ESCALATE_TO_CLIENT
  CLIENT_PROVIDE_INFO
  MEMBER_REQUEST_INFO
  PM_LEAD_RESPOND_TO_MEMBER
  PM_MEMBER_SUBMIT
  PM_RETURN_TO_MEMBER
  ASSIGN_LEADER
  ASSIGN_MEMBER
  FORWARD_TO_TMS
  ASSIGN_TMS_CHAIN
  SUBMIT_DRAWING
  REVIEW_CHECKING_APPROVE
  REVIEW_CHECKING_REJECT
  REVIEW_APPROVAL_APPROVE
  REVIEW_APPROVAL_REJECT
  ENGINEERING_REQUEST_PM_REVISION
  TMS_MEMBER_REQUEST_LEAD
  TMS_LEAD_RESPOND_TO_MEMBER
  ENGINEERING_SUBMIT_TO_MARKETING
  MARKETING_SUBMIT_TO_CLIENT
  MARKETING_REQUEST_ENGINEERING_REVISION
  MARKETING_ROUTE_CLIENT_REVISION_TO_TMS
  MARKETING_SUBMIT_CLIENT_REVISION
  ENGINEERING_REQUEST_TMS_REVISION
  CLIENT_REQUEST_REVISION
  CLIENT_ACCEPT_FINAL
  CLIENT_REJECT_FINAL
  ORIGIN_MEMBER_APPROVE
  ORIGIN_MEMBER_REJECT
  ORIGIN_MANAGER_APPROVE
  FORWARD_TO_CCR
  SEND_BACKWARD
  LIST_FINAL_DOCUMENT
  DECIDE_BID_OUTCOME
  REQUEST_ARCHIVED_BID_REVIEW
  UPDATE_SETTINGS
}

Enum work_priority_code {
  High
  Medium
  Low
}

Enum attachment_source_type_code {
  TEXT
  FILE
  TEXT_AND_FILE
  METADATA
}

Enum attachment_file_group_code {
  PRIMARY
  WORKFLOW
}

Enum document_group_code {
  MARKETING
  ENGINEERING
  CUSTOM
}

Enum info_request_status_code {
  OPEN
  RESPONDED
  CANCELLED
  SUPERSEDED
}

Enum revision_request_status_code {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

Enum decision_result_code {
  APPROVED
  REJECTED
  ACCEPTED
  DECLINED
  REVISION_REQUESTED
  RETURNED
}

Enum bid_outcome_code {
  WIN
  LOSE
}

Enum notification_kind_code {
  PROJECT
  REQUEST
  SYSTEM
}

Enum notification_target_view_code {
  focus
  details
}

Enum document_link_type_code {
  INITIAL_UPLOAD
  WORKFLOW_UPLOAD
  FINAL_PACKAGE
  CLIENT_REVISION
  REVISION_RESPONSE
  REGISTRY_LISTED
}

Enum folder_type_code {
  ROOT
  CATEGORY
  DATE
  DATE_REVISION
  CUSTOM
}

Enum option_type_code {
  POL
  POD
  CARGO_CODE
  VESSEL_CODE
  PROJECT_INFO_CATEGORY
  WORK_REQUEST_TYPE
  DOCUMENT_CATEGORY
  ATTACHMENT_CATEGORY
}

Enum assignment_type_code {
  PM_LEADER
  PM_MEMBER
  TMS_MANAGER
  TMS_DRAWING
  TMS_CHECKING
  TMS_APPROVAL
}

Enum audit_entity_type_code {
  PROJECT
  WORK_REQUEST
  DOCUMENT
  TEAM
  MEMBER
  CLIENT
  COMPANY
  SETTING
  NOTIFICATION
}

/* =========================================================
   IDENTITY / ACCESS MODULE
   ========================================================= */

Table users {
  id uuid [pk]
  full_name varchar(160) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255)
  avatar_url text
  is_active boolean [not null, default: true]
  last_login_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (email) [unique]
  }
}

Table roles {
  id uuid [pk]
  code actor_role_code [not null, unique]
  name varchar(120) [not null]
  description text
  is_system_role boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (code) [unique]
  }
}

Table user_roles {
  id uuid [pk]
  user_id uuid [not null]
  role_id uuid [not null]
  assigned_by_user_id uuid
  assigned_at timestamp [not null, default: `now()`]
  revoked_at timestamp

  indexes {
    (user_id, role_id, revoked_at)
  }
}

Table actor_profiles {
  id uuid [pk]
  user_id uuid
  role_id uuid [not null]
  member_id uuid
  client_contact_id uuid
  label varchar(180) [not null]
  is_default boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]

  Note: '''
  Represents the frontend Actor concept.
  An actor may be linked to an internal member or an external client contact.
  '''
}

Table auth_sessions {
  id uuid [pk]
  user_id uuid [not null]
  refresh_token_hash varchar(255) [not null]
  ip_address varchar(80)
  user_agent text
  expires_at timestamp [not null]
  revoked_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id)
    (expires_at)
  }
}

Table password_reset_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(255) [not null, unique]
  expires_at timestamp [not null]
  used_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (token_hash) [unique]
    (user_id)
  }
}

/* =========================================================
   ORGANIZATION MODULE
   ========================================================= */

Table company_types {
  id uuid [pk]
  name varchar(100) [not null, unique]
  description text
}

Table companies {
  id uuid [pk]
  name varchar(180) [not null]
  abbr varchar(30) [not null]
  company_type_id uuid
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (abbr) [unique]
    (name)
  }
}

Table division_types {
  id uuid [pk]
  name varchar(100) [not null, unique]
  description text
}

Table divisions {
  id uuid [pk]
  company_id uuid [not null]
  name varchar(180) [not null]
  abbr varchar(30) [not null]
  division_type_id uuid
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (company_id, abbr) [unique]
    (company_id, name)
  }
}

Table members {
  id uuid [pk]
  user_id uuid
  company_id uuid [not null]
  division_id uuid [not null]
  name varchar(160) [not null]
  email varchar(255) [not null, unique]
  role_title varchar(140) [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (email) [unique]
    (company_id)
    (division_id)
  }
}

Table teams {
  id uuid [pk]
  company_id uuid [not null]
  division_id uuid [not null]
  name varchar(180) [not null]
  lead_member_id uuid
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (division_id, name) [unique]
  }
}

Table team_members {
  id uuid [pk]
  team_id uuid [not null]
  member_id uuid [not null]
  team_role varchar(100)
  joined_at timestamp [not null, default: `now()`]
  left_at timestamp

  indexes {
    (team_id, member_id, left_at)
  }
}

Table clients {
  id uuid [pk]
  company_id uuid
  name varchar(180) [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (name)
  }
}

Table client_contacts {
  id uuid [pk]
  user_id uuid
  client_id uuid [not null]
  name varchar(160) [not null]
  email varchar(255) [not null]
  designation varchar(140)
  phone varchar(60)
  is_primary boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (client_id, email) [unique]
    (email)
  }
}

/* =========================================================
   SETTINGS / NAMING CONFIGURATION MODULE
   ========================================================= */

Table portal_configs {
  id uuid [pk]
  portal_name varchar(180) [not null]
  default_timezone varchar(80) [not null, default: 'Asia/Dhaka']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table option_types {
  id uuid [pk]
  code option_type_code [not null, unique]
  name varchar(120) [not null]
  description text
  is_active boolean [not null, default: true]
}

Table option_values {
  id uuid [pk]
  option_type_id uuid [not null]
  name varchar(180) [not null]
  code varchar(40)
  sort_order int [not null, default: 0]
  is_default boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (option_type_id, name) [unique]
    (option_type_id, code)
  }
}

Table document_code_options {
  id uuid [pk]
  document_group document_group_code [not null]
  code varchar(20) [not null]
  name varchar(180) [not null]
  description text
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: '''
  Examples:
  MARKETING: 000 Info, 001 Project Information, 002 Cargo Information, 011 Action Log,
  012 Contact List, 013 Comment Sheet, 802 Contract, 803 Invoice.
  ENGINEERING: 100 Stowage Plan, 101 Shipment Calculation, 110 Interference Check.
  '''

  indexes {
    (document_group, code) [unique]
    (document_group, name)
  }
}

/* =========================================================
   WORKSPACE / PROJECT / BID MODULE
   ========================================================= */

Table workspace_types {
  id uuid [pk]
  code workspace_type_code [not null, unique]
  name varchar(80) [not null]
}

Table project_statuses {
  id uuid [pk]
  code project_status_code [not null, unique]
  name varchar(100) [not null]
  sort_order int [not null, default: 0]
  is_terminal boolean [not null, default: false]
}

Table source_channels {
  id uuid [pk]
  name varchar(120) [not null, unique]
  description text
  is_active boolean [not null, default: true]
}

Table projects {
  id uuid [pk]
  code varchar(60) [not null, unique]
  name varchar(220) [not null]
  workspace_type_id uuid [not null]
  client_id uuid [not null]
  origin_division_id uuid [not null]
  source_channel_id uuid
  created_by_actor_id uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: '''
  Represents both BIDs and PROJECTS.
  Current status is derived from latest project_status_events.to_status_id.
  Bid-to-project conversion is tracked in bid_outcome_events/project_conversion_events.
  '''

  indexes {
    (code) [unique]
    (workspace_type_id)
    (client_id)
    (origin_division_id)
    (created_at)
  }
}

Table project_status_events {
  id uuid [pk]
  project_id uuid [not null]
  from_status_id uuid
  to_status_id uuid [not null]
  changed_by_actor_id uuid
  reason text
  occurred_at timestamp [not null, default: `now()`]

  indexes {
    (project_id, occurred_at)
    (to_status_id)
  }
}

Table bid_details {
  id uuid [pk]
  project_id uuid [not null, unique]
  bidding_number varchar(60) [not null]
  project_name varchar(220) [not null]
  pol_option_id uuid
  pod_option_id uuid
  project_code varchar(40) [not null]
  cargo_name varchar(180) [not null]
  cargo_code_option_id uuid
  vessel_name varchar(180) [not null]
  vessel_code_option_id uuid
  shipment_number varchar(10) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (project_id) [unique]
    (bidding_number)
    (shipment_number)
  }
}

Table project_credential_deliveries {
  id uuid [pk]
  project_id uuid [not null]
  client_contact_id uuid
  sent_by_actor_id uuid
  sent_to_email varchar(255) [not null]
  sent_at timestamp [not null, default: `now()`]
  delivery_status varchar(80) [not null, default: 'SENT']
  failure_reason text

  Note: '''
  Replaces frontend credentialsSent boolean.
  '''

  indexes {
    (project_id)
    (sent_at)
  }
}

Table bid_outcome_events {
  id uuid [pk]
  project_id uuid [not null]
  outcome bid_outcome_code [not null]
  previous_project_code varchar(60)
  new_project_code varchar(60)
  decided_by_actor_id uuid [not null]
  decided_at timestamp [not null, default: `now()`]
  note text

  indexes {
    (project_id, decided_at)
    (outcome)
  }
}

Table project_conversion_events {
  id uuid [pk]
  project_id uuid [not null]
  from_workspace_type_id uuid [not null]
  to_workspace_type_id uuid [not null]
  from_code varchar(60) [not null]
  to_code varchar(60) [not null]
  converted_by_actor_id uuid [not null]
  converted_at timestamp [not null, default: `now()`]
  note text

  indexes {
    (project_id, converted_at)
  }
}

Table archived_bid_review_requests {
  id uuid [pk]
  project_id uuid [not null]
  requested_by_actor_id uuid [not null]
  note text
  requested_at timestamp [not null, default: `now()`]
  restored_work_request_id uuid

  indexes {
    (project_id, requested_at)
  }
}

/* =========================================================
   DOCUMENT / FILE / FOLDER MODULE
   ========================================================= */

Table document_categories {
  id uuid [pk]
  name varchar(160) [not null]
  code varchar(40)
  description text
  is_active boolean [not null, default: true]

  indexes {
    (name) [unique]
    (code)
  }
}

Table attachment_source_types {
  id uuid [pk]
  code attachment_source_type_code [not null, unique]
  name varchar(80) [not null]
}

Table attachment_file_groups {
  id uuid [pk]
  code attachment_file_group_code [not null, unique]
  name varchar(80) [not null]
}

Table documents {
  id uuid [pk]
  project_id uuid [not null]
  work_request_id uuid
  document_code_option_id uuid
  document_category_id uuid
  file_group_id uuid [not null]
  title varchar(260) [not null]
  description text
  created_by_actor_id uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Note: '''
  Logical document record.
  Versions, revision uploads, generated file names, and physical files are stored in document_versions.
  '''

  indexes {
    (project_id)
    (work_request_id)
    (document_code_option_id)
    (document_category_id)
  }
}

Table document_versions {
  id uuid [pk]
  document_id uuid [not null]
  version_number int [not null]
  version_key varchar(260)
  source_type_id uuid [not null]
  workflow_stage_status_id uuid
  original_file_name varchar(260)
  generated_file_name varchar(260)
  file_extension varchar(20)
  mime_type varchar(120)
  file_size_bytes bigint
  storage_bucket varchar(120)
  storage_key text
  storage_url text
  text_content text
  note text
  is_revision_upload boolean [not null, default: false]
  revision_code varchar(20)
  uploaded_by_actor_id uuid [not null]
  uploaded_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  indexes {
    (document_id, version_number) [unique]
    (document_id, uploaded_at)
    (workflow_stage_status_id)
    (is_revision_upload)
  }
}

Table document_folders {
  id uuid [pk]
  project_id uuid [not null]
  parent_folder_id uuid
  folder_type folder_type_code [not null]
  folder_name varchar(260) [not null]
  sort_order int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]

  Note: '''
  Supports:
  Root folder: [Bid Code] - [Client Name] - [Project Name] - [Cargo Name]
  Category folder: [Document Code] [Document Name]
  Date / revision folder: DD-MM-YYYY or DD-MM-YYYY Rev-A
  '''

  indexes {
    (project_id, parent_folder_id, folder_name) [unique]
  }
}

Table document_version_folder_locations {
  id uuid [pk]
  document_version_id uuid [not null]
  folder_id uuid [not null]
  folder_path text
  linked_at timestamp [not null, default: `now()`]

  indexes {
    (document_version_id, folder_id) [unique]
  }
}

Table document_version_links {
  id uuid [pk]
  work_request_id uuid [not null]
  document_version_id uuid [not null]
  link_type document_link_type_code [not null]
  linked_by_actor_id uuid
  linked_at timestamp [not null, default: `now()`]

  Note: '''
  Replaces finalPackageAttachmentIds and clientRevisionAttachmentIds arrays.
  Also supports initial uploads, workflow uploads, revision responses, and registry listing.
  '''

  indexes {
    (work_request_id, document_version_id, link_type) [unique]
    (link_type)
  }
}

/* =========================================================
   WORK REQUEST / WORKFLOW MODULE
   ========================================================= */

Table work_request_categories {
  id uuid [pk]
  name varchar(160) [not null, unique]
  description text
  is_active boolean [not null, default: true]
}

Table work_priorities {
  id uuid [pk]
  code work_priority_code [not null, unique]
  name varchar(80) [not null]
  sort_order int [not null, default: 0]
}

Table work_request_attachment_categories {
  id uuid [pk]
  name varchar(160) [not null, unique]
  description text
  is_active boolean [not null, default: true]
}

Table workflow_statuses {
  id uuid [pk]
  code work_request_status_code [not null, unique]
  name varchar(180) [not null]
  description text
  sort_order int [not null, default: 0]
  is_terminal boolean [not null, default: false]

  indexes {
    (code) [unique]
  }
}

Table workflow_action_definitions {
  id uuid [pk]
  code workflow_action_code [not null, unique]
  name varchar(180) [not null]
  description text
  is_user_visible boolean [not null, default: true]
  is_revision_action boolean [not null, default: false]
  is_info_request_action boolean [not null, default: false]
  is_assignment_action boolean [not null, default: false]
  is_terminal_action boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (code) [unique]
  }
}

Table workflow_transitions {
  id uuid [pk]
  action_id uuid [not null]
  from_status_id uuid
  to_status_id uuid [not null]
  from_role_id uuid
  target_role_id uuid
  requires_assignment boolean [not null, default: false]
  is_backward_transition boolean [not null, default: false]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]

  Note: '''
  Stores allowed cycle transitions.
  from_status_id can be null for create/init actions.
  '''

  indexes {
    (action_id, from_status_id, to_status_id)
    (from_role_id)
  }
}

Table workflow_action_role_permissions {
  id uuid [pk]
  action_id uuid [not null]
  role_id uuid [not null]
  allowed boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (action_id, role_id) [unique]
  }
}

Table work_requests {
  id uuid [pk]
  code varchar(80) [not null, unique]
  project_id uuid [not null]
  title varchar(260) [not null]
  category_id uuid [not null]
  priority_id uuid [not null]
  attachment_category_id uuid
  requested_document_title varchar(260)
  notes text
  assigned_division_id uuid [not null]
  origin_division_id uuid [not null]
  created_by_actor_id uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Note: '''
  Current workflow status is derived from latest work_request_audit_logs.to_status_id.
  parentType is not stored because project_id points to projects, and project type is normalized in projects.workspace_type_id.
  '''

  indexes {
    (code) [unique]
    (project_id)
    (assigned_division_id)
    (origin_division_id)
    (created_at)
  }
}

Table work_request_assignments {
  id uuid [pk]
  work_request_id uuid [not null]
  assignment_type assignment_type_code [not null]
  member_id uuid [not null]
  assigned_by_actor_id uuid
  assigned_at timestamp [not null, default: `now()`]
  unassigned_at timestamp
  note text

  Note: '''
  Normalizes assignedLeaderId, assignedMemberId, and TMS manager/M1/M2/M3 assignments.
  '''

  indexes {
    (work_request_id, assignment_type, unassigned_at)
    (member_id)
  }
}

Table work_request_audit_logs {
  id uuid [pk]
  work_request_id uuid [not null]
  action_id uuid
  from_status_id uuid
  to_status_id uuid
  performed_by_actor_id uuid
  performed_by_label varchar(180)
  from_label varchar(180)
  to_label varchar(180)
  action_text text [not null]
  note text
  occurred_at timestamp [not null, default: `now()`]

  Note: '''
  Backend replacement for revisionHistory.
  This table supports document-specific audit trail by filtering with work_request_id.
  '''

  indexes {
    (work_request_id, occurred_at)
    (action_id)
    (to_status_id)
    (performed_by_actor_id)
  }
}

Table work_request_notes {
  id uuid [pk]
  work_request_id uuid [not null]
  audit_log_id uuid
  note text [not null]
  created_by_actor_id uuid [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (work_request_id, created_at)
  }
}

Table work_request_audit_attachments {
  id uuid [pk]
  audit_log_id uuid [not null]
  document_version_id uuid [not null]
  attached_at timestamp [not null, default: `now()`]

  indexes {
    (audit_log_id, document_version_id) [unique]
  }
}

/* =========================================================
   INFO REQUEST / CLARIFICATION MODULE
   ========================================================= */

Table info_request_statuses {
  id uuid [pk]
  code info_request_status_code [not null, unique]
  name varchar(120) [not null]
}

Table workflow_info_requests {
  id uuid [pk]
  work_request_id uuid [not null]
  parent_info_request_id uuid
  requested_by_actor_id uuid [not null]
  requested_by_member_id uuid
  requested_by_role_id uuid [not null]
  target_label varchar(180) [not null]
  target_role_id uuid
  target_member_id uuid
  target_client_contact_id uuid
  status_at_request_id uuid [not null]
  info_request_status_id uuid [not null]
  note text
  requested_at timestamp [not null, default: `now()`]
  closed_at timestamp

  Note: '''
  Normalizes pendingInfoRequest and infoRequestStack.
  parent_info_request_id supports stacked/nested info requests.
  '''

  indexes {
    (work_request_id, info_request_status_id)
    (target_role_id)
    (target_member_id)
    (target_client_contact_id)
  }
}

Table workflow_info_responses {
  id uuid [pk]
  info_request_id uuid [not null]
  responded_by_actor_id uuid [not null]
  response_note text
  responded_at timestamp [not null, default: `now()`]

  indexes {
    (info_request_id)
    (responded_by_actor_id)
  }
}

/* =========================================================
   REVISION / DECISION MODULE
   ========================================================= */

Table revision_request_statuses {
  id uuid [pk]
  code revision_request_status_code [not null, unique]
  name varchar(120) [not null]
}

Table work_request_revision_requests {
  id uuid [pk]
  work_request_id uuid [not null]
  source_action_id uuid
  requested_by_actor_id uuid [not null]
  requested_to_role_id uuid
  requested_to_member_id uuid
  status_at_request_id uuid
  revision_status_id uuid [not null]
  revision_code varchar(20)
  note text
  requested_at timestamp [not null, default: `now()`]
  closed_at timestamp

  Note: '''
  Supports PM revision, Engineering revision, TMS revision, Client revision, and archived bid review revision loops.
  '''

  indexes {
    (work_request_id, requested_at)
    (revision_status_id)
  }
}

Table work_request_revision_documents {
  id uuid [pk]
  revision_request_id uuid [not null]
  document_version_id uuid [not null]
  attached_by_actor_id uuid
  attached_at timestamp [not null, default: `now()`]

  indexes {
    (revision_request_id, document_version_id) [unique]
  }
}

Table work_request_revision_submissions {
  id uuid [pk]
  revision_request_id uuid [not null]
  submitted_by_actor_id uuid [not null]
  submission_note text
  submitted_at timestamp [not null, default: `now()`]

  indexes {
    (revision_request_id, submitted_at)
  }
}

Table work_request_revision_submission_documents {
  id uuid [pk]
  revision_submission_id uuid [not null]
  document_version_id uuid [not null]
  attached_at timestamp [not null, default: `now()`]

  indexes {
    (revision_submission_id, document_version_id) [unique]
  }
}

Table decision_results {
  id uuid [pk]
  code decision_result_code [not null, unique]
  name varchar(120) [not null]
}

Table work_request_decisions {
  id uuid [pk]
  work_request_id uuid [not null]
  action_id uuid [not null]
  decision_result_id uuid [not null]
  decided_by_actor_id uuid [not null]
  from_status_id uuid
  to_status_id uuid
  note text
  decided_at timestamp [not null, default: `now()`]

  Note: '''
  Captures approvals/rejections:
  checking approve/reject, approval approve/reject, origin member decision,
  client accept/reject/request revision, review decision.
  '''

  indexes {
    (work_request_id, decided_at)
    (decision_result_id)
  }
}

/* =========================================================
   FINAL REGISTRY / HML DOCUMENT MODULE
   ========================================================= */

Table registry_documents {
  id uuid [pk]
  project_id uuid [not null]
  work_request_id uuid [not null]
  document_id uuid
  listed_document_version_id uuid
  listed_category_id uuid
  listed_by_actor_id uuid [not null]
  listed_at timestamp [not null, default: `now()`]
  registry_note text
  removed_at timestamp
  removed_by_actor_id uuid

  Note: '''
  Backend replacement for RegistryDocument.
  Stores final listed/HML documents after acceptance.
  '''

  indexes {
    (project_id)
    (work_request_id)
    (listed_at)
  }
}

/* =========================================================
   NOTIFICATION MODULE
   ========================================================= */

Table notifications {
  id uuid [pk]
  notification_kind notification_kind_code [not null]
  project_id uuid
  work_request_id uuid
  audit_log_id uuid
  title varchar(260) [not null]
  subtitle varchar(260)
  role_message varchar(260)
  target_view notification_target_view_code
  triggered_by_actor_id uuid
  triggered_by_label varchar(180)
  triggered_at timestamp [not null, default: `now()`]
  expires_at timestamp

  indexes {
    (project_id)
    (work_request_id)
    (triggered_at)
  }
}

Table notification_recipients {
  id uuid [pk]
  notification_id uuid [not null]
  actor_id uuid [not null]
  delivered_at timestamp [not null, default: `now()`]
  read_at timestamp
  opened_at timestamp
  dismissed_at timestamp

  indexes {
    (notification_id, actor_id) [unique]
    (actor_id, read_at)
  }
}

/* =========================================================
   GENERIC SYSTEM AUDIT MODULE
   ========================================================= */

Table system_audit_logs {
  id uuid [pk]
  entity_type audit_entity_type_code [not null]
  entity_id uuid [not null]
  action_id uuid
  performed_by_actor_id uuid
  summary text [not null]
  before_data jsonb
  after_data jsonb
  occurred_at timestamp [not null, default: `now()`]

  Note: '''
  Generic audit for non-work-request modules:
  company, division, team, member, client, setting, project metadata, notification.
  Work request cycle audit remains in work_request_audit_logs.
  '''

  indexes {
    (entity_type, entity_id)
    (performed_by_actor_id)
    (occurred_at)
  }
}

/* =========================================================
   RELATIONSHIPS
   ========================================================= */

/* Identity / Access */
Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id
Ref: user_roles.assigned_by_user_id > users.id

Ref: actor_profiles.user_id > users.id
Ref: actor_profiles.role_id > roles.id
Ref: actor_profiles.member_id > members.id
Ref: actor_profiles.client_contact_id > client_contacts.id

Ref: auth_sessions.user_id > users.id
Ref: password_reset_tokens.user_id > users.id

/* Organization */
Ref: companies.company_type_id > company_types.id

Ref: divisions.company_id > companies.id
Ref: divisions.division_type_id > division_types.id

Ref: members.user_id > users.id
Ref: members.company_id > companies.id
Ref: members.division_id > divisions.id

Ref: teams.company_id > companies.id
Ref: teams.division_id > divisions.id
Ref: teams.lead_member_id > members.id

Ref: team_members.team_id > teams.id
Ref: team_members.member_id > members.id

Ref: clients.company_id > companies.id

Ref: client_contacts.user_id > users.id
Ref: client_contacts.client_id > clients.id

/* Settings */
Ref: option_values.option_type_id > option_types.id

/* Project / Bid */
Ref: projects.workspace_type_id > workspace_types.id
Ref: projects.client_id > clients.id
Ref: projects.origin_division_id > divisions.id
Ref: projects.source_channel_id > source_channels.id
Ref: projects.created_by_actor_id > actor_profiles.id

Ref: project_status_events.project_id > projects.id
Ref: project_status_events.from_status_id > project_statuses.id
Ref: project_status_events.to_status_id > project_statuses.id
Ref: project_status_events.changed_by_actor_id > actor_profiles.id

Ref: bid_details.project_id - projects.id
Ref: bid_details.pol_option_id > option_values.id
Ref: bid_details.pod_option_id > option_values.id
Ref: bid_details.cargo_code_option_id > option_values.id
Ref: bid_details.vessel_code_option_id > option_values.id

Ref: project_credential_deliveries.project_id > projects.id
Ref: project_credential_deliveries.client_contact_id > client_contacts.id
Ref: project_credential_deliveries.sent_by_actor_id > actor_profiles.id

Ref: bid_outcome_events.project_id > projects.id
Ref: bid_outcome_events.decided_by_actor_id > actor_profiles.id

Ref: project_conversion_events.project_id > projects.id
Ref: project_conversion_events.from_workspace_type_id > workspace_types.id
Ref: project_conversion_events.to_workspace_type_id > workspace_types.id
Ref: project_conversion_events.converted_by_actor_id > actor_profiles.id

Ref: archived_bid_review_requests.project_id > projects.id
Ref: archived_bid_review_requests.requested_by_actor_id > actor_profiles.id
Ref: archived_bid_review_requests.restored_work_request_id > work_requests.id

/* Documents */
Ref: documents.project_id > projects.id
Ref: documents.work_request_id > work_requests.id
Ref: documents.document_code_option_id > document_code_options.id
Ref: documents.document_category_id > document_categories.id
Ref: documents.file_group_id > attachment_file_groups.id
Ref: documents.created_by_actor_id > actor_profiles.id

Ref: document_versions.document_id > documents.id
Ref: document_versions.source_type_id > attachment_source_types.id
Ref: document_versions.workflow_stage_status_id > workflow_statuses.id
Ref: document_versions.uploaded_by_actor_id > actor_profiles.id

Ref: document_folders.project_id > projects.id
Ref: document_folders.parent_folder_id > document_folders.id

Ref: document_version_folder_locations.document_version_id > document_versions.id
Ref: document_version_folder_locations.folder_id > document_folders.id

Ref: document_version_links.work_request_id > work_requests.id
Ref: document_version_links.document_version_id > document_versions.id
Ref: document_version_links.linked_by_actor_id > actor_profiles.id

/* Workflow setup */
Ref: workflow_transitions.action_id > workflow_action_definitions.id
Ref: workflow_transitions.from_status_id > workflow_statuses.id
Ref: workflow_transitions.to_status_id > workflow_statuses.id
Ref: workflow_transitions.from_role_id > roles.id
Ref: workflow_transitions.target_role_id > roles.id

Ref: workflow_action_role_permissions.action_id > workflow_action_definitions.id
Ref: workflow_action_role_permissions.role_id > roles.id

/* Work requests */
Ref: work_requests.project_id > projects.id
Ref: work_requests.category_id > work_request_categories.id
Ref: work_requests.priority_id > work_priorities.id
Ref: work_requests.attachment_category_id > work_request_attachment_categories.id
Ref: work_requests.assigned_division_id > divisions.id
Ref: work_requests.origin_division_id > divisions.id
Ref: work_requests.created_by_actor_id > actor_profiles.id

Ref: work_request_assignments.work_request_id > work_requests.id
Ref: work_request_assignments.member_id > members.id
Ref: work_request_assignments.assigned_by_actor_id > actor_profiles.id

Ref: work_request_audit_logs.work_request_id > work_requests.id
Ref: work_request_audit_logs.action_id > workflow_action_definitions.id
Ref: work_request_audit_logs.from_status_id > workflow_statuses.id
Ref: work_request_audit_logs.to_status_id > workflow_statuses.id
Ref: work_request_audit_logs.performed_by_actor_id > actor_profiles.id

Ref: work_request_notes.work_request_id > work_requests.id
Ref: work_request_notes.audit_log_id > work_request_audit_logs.id
Ref: work_request_notes.created_by_actor_id > actor_profiles.id

Ref: work_request_audit_attachments.audit_log_id > work_request_audit_logs.id
Ref: work_request_audit_attachments.document_version_id > document_versions.id

/* Info requests */
Ref: workflow_info_requests.work_request_id > work_requests.id
Ref: workflow_info_requests.parent_info_request_id > workflow_info_requests.id
Ref: workflow_info_requests.requested_by_actor_id > actor_profiles.id
Ref: workflow_info_requests.requested_by_member_id > members.id
Ref: workflow_info_requests.requested_by_role_id > roles.id
Ref: workflow_info_requests.target_role_id > roles.id
Ref: workflow_info_requests.target_member_id > members.id
Ref: workflow_info_requests.target_client_contact_id > client_contacts.id
Ref: workflow_info_requests.status_at_request_id > workflow_statuses.id
Ref: workflow_info_requests.info_request_status_id > info_request_statuses.id

Ref: workflow_info_responses.info_request_id > workflow_info_requests.id
Ref: workflow_info_responses.responded_by_actor_id > actor_profiles.id

/* Revision / decisions */
Ref: work_request_revision_requests.work_request_id > work_requests.id
Ref: work_request_revision_requests.source_action_id > workflow_action_definitions.id
Ref: work_request_revision_requests.requested_by_actor_id > actor_profiles.id
Ref: work_request_revision_requests.requested_to_role_id > roles.id
Ref: work_request_revision_requests.requested_to_member_id > members.id
Ref: work_request_revision_requests.status_at_request_id > workflow_statuses.id
Ref: work_request_revision_requests.revision_status_id > revision_request_statuses.id

Ref: work_request_revision_documents.revision_request_id > work_request_revision_requests.id
Ref: work_request_revision_documents.document_version_id > document_versions.id
Ref: work_request_revision_documents.attached_by_actor_id > actor_profiles.id

Ref: work_request_revision_submissions.revision_request_id > work_request_revision_requests.id
Ref: work_request_revision_submissions.submitted_by_actor_id > actor_profiles.id

Ref: work_request_revision_submission_documents.revision_submission_id > work_request_revision_submissions.id
Ref: work_request_revision_submission_documents.document_version_id > document_versions.id

Ref: work_request_decisions.work_request_id > work_requests.id
Ref: work_request_decisions.action_id > workflow_action_definitions.id
Ref: work_request_decisions.decision_result_id > decision_results.id
Ref: work_request_decisions.decided_by_actor_id > actor_profiles.id
Ref: work_request_decisions.from_status_id > workflow_statuses.id
Ref: work_request_decisions.to_status_id > workflow_statuses.id

/* Registry */
Ref: registry_documents.project_id > projects.id
Ref: registry_documents.work_request_id > work_requests.id
Ref: registry_documents.document_id > documents.id
Ref: registry_documents.listed_document_version_id > document_versions.id
Ref: registry_documents.listed_category_id > document_categories.id
Ref: registry_documents.listed_by_actor_id > actor_profiles.id
Ref: registry_documents.removed_by_actor_id > actor_profiles.id

/* Notifications */
Ref: notifications.project_id > projects.id
Ref: notifications.work_request_id > work_requests.id
Ref: notifications.audit_log_id > work_request_audit_logs.id
Ref: notifications.triggered_by_actor_id > actor_profiles.id

Ref: notification_recipients.notification_id > notifications.id
Ref: notification_recipients.actor_id > actor_profiles.id

/* System audit */
Ref: system_audit_logs.action_id > workflow_action_definitions.id
Ref: system_audit_logs.performed_by_actor_id > actor_profiles.id

/* =========================================================
   TABLE GROUPS
   ========================================================= */

TableGroup Identity_Access_Module {
  users
  roles
  user_roles
  actor_profiles
  auth_sessions
  password_reset_tokens
}

TableGroup Organization_Module {
  company_types
  companies
  division_types
  divisions
  members
  teams
  team_members
  clients
  client_contacts
}

TableGroup Settings_Naming_Module {
  portal_configs
  option_types
  option_values
  document_code_options
}

TableGroup Project_Bid_Module {
  workspace_types
  project_statuses
  source_channels
  projects
  project_status_events
  bid_details
  project_credential_deliveries
  bid_outcome_events
  project_conversion_events
  archived_bid_review_requests
}

TableGroup Document_File_Module {
  document_categories
  attachment_source_types
  attachment_file_groups
  documents
  document_versions
  document_folders
  document_version_folder_locations
  document_version_links
}

TableGroup Workflow_Module {
  work_request_categories
  work_priorities
  work_request_attachment_categories
  workflow_statuses
  workflow_action_definitions
  workflow_transitions
  workflow_action_role_permissions
  work_requests
  work_request_assignments
  work_request_audit_logs
  work_request_notes
  work_request_audit_attachments
}

TableGroup Info_Request_Module {
  info_request_statuses
  workflow_info_requests
  workflow_info_responses
}

TableGroup Revision_Decision_Module {
  revision_request_statuses
  work_request_revision_requests
  work_request_revision_documents
  work_request_revision_submissions
  work_request_revision_submission_documents
  decision_results
  work_request_decisions
}

TableGroup Registry_Module {
  registry_documents
}

TableGroup Notification_Module {
  notifications
  notification_recipients
}

TableGroup System_Audit_Module {
  system_audit_logs
}
