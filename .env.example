# Copy this file to .env and replace the placeholders with the connection string
# shown in your Neon dashboard. Keep sslmode=require for a secure connection.
# Running `yarn start:dev` generates Prisma Client and applies migrations first.
DATABASE_URL="postgresql://NEON_USER:NEON_PASSWORD@NEON_HOST/NEON_DATABASE?sslmode=require"
PORT=3000
NODE_ENV=development
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=project-portal:
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Project Portal <no-reply@example.com>"
MAIL_QUEUE_NAME=mail
MAIL_WORKER_ENABLED=false
