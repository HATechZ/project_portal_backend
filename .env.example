# Docker is used only for local infrastructure. The NestJS app runs on the host,
# so container ports are published on 127.0.0.1 and service URLs use that address.
# Replace the database placeholders with the connection string from Neon.
# Run Prisma generation and migrations manually after schema changes.
DATABASE_URL="postgresql://NEON_USER:NEON_PASSWORD@NEON_HOST/NEON_DATABASE?sslmode=verify-full"
PORT=3000
NODE_ENV=development
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=project-portal:
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=project-portal-api
JWT_AUDIENCE=project-portal-client
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Maximum lifetime of a login session, even when refresh tokens are rotated.
JWT_SESSION_ABSOLUTE_TTL_SECONDS=7776000
PASSWORD_RESET_TTL_SECONDS=1800
PASSWORD_RESET_URL=http://localhost:3000/reset-password
SEED_ADMIN_EMAIL=admin@project-portal.local
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_PASSWORD=
SEED_TENANT_ID=00000000-0000-4000-8000-000000000001
SEED_TENANT_NAME=Default Organization
SEED_TENANT_SLUG=default
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Project Portal <no-reply@example.com>"
MAIL_QUEUE_NAME=mail
MAIL_WORKER_ENABLED=false
# Outbox relay. Only processes with this enabled publish domain events; leave it
# false on every instance but the designated one, or events publish N times.
MESSAGING_RELAY_ENABLED=false
MESSAGING_RELAY_INTERVAL_MS=1000
MESSAGING_RELAY_BATCH_SIZE=100
# Broker endpoint for the docker-compose rabbitmq service. Unused until the
# RabbitMQ transport lands (Phase 7) — the in-process transport needs no broker.
RABBITMQ_URL=amqp://portal:portal@127.0.0.1:5672
