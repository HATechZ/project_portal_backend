// Division leadership is an explicit, persisted assignment: a Member may lead many
// Divisions, a Division has at most one active Lead. Leadership is revoked by setting
// revokedAt; rows are never deleted. The "at most one active Lead per Division" and
// "no duplicate active (division, member) pair" rules are PARTIAL unique indexes
// (WHERE revoked_at IS NULL) and MUST be hand-written as raw SQL in the
// *_division_lead_multiplicity migration, together with the tenant RLS policy and the
// app_user SELECT/INSERT/UPDATE grants (no DELETE) — none of the three are expressible
// here. Prisma's @@unique carries no predicate, so do not replace them with a plain
// @@unique: a non-partial unique would permanently bar re-assigning a Member to a
// Division it previously led. See specs/04.1.1-division-lead-multiplicity/DATA_CONTRACT.md.
model DivisionLead {
  tenantId         String    @map("tenant_id") @db.Uuid
  id               String    @id @map("id") @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  divisionId       String    @map("division_id") @db.Uuid
  memberId         String    @map("member_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamp(6)
  assignedByUserId String    @map("assigned_by_user_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamp(6)
  revokedByUserId  String?   @map("revoked_by_user_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  division Division @relation("DivisionLeadsDivisionIdDivisions", fields: [divisionId, tenantId, companyId], references: [id, tenantId, companyId])
  member   Member   @relation("DivisionLeadsMemberIdMembers", fields: [memberId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, memberId, revokedAt])
  @@index([tenantId, divisionId, revokedAt])
  @@map("division_leads")
}

