  workRequestRevisionSubmissionsByRevisionRequestId WorkRequestRevisionSubmission[] @relation("WorkRequestRevisionSubmissionsRevisionRequestIdWorkRequestRevisionRequests")

  @@index([workRequestId, requestedAt])
  @@index([revisionStatusId])
  @@index([tenantId])
  @@map("work_request_revision_requests")
}

model WorkRequestRevisionDocument {
