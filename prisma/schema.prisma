generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ActorRoleCode {
  system_admin
  ccr_coordinator
  division_lead
  division_member
  tms_manager
  tms_drawing
  tms_checking
  tms_approval
  client_owner
  @@map("actor_role_code")
}

enum WorkspaceTypeCode {
  BID
  PROJECT
  @@map("workspace_type_code")
}

enum ProjectStatusCode {
  DRAFT
  BIDDING
  ACTIVE
  COMPLETED
  ARCHIVED
  @@map("project_status_code")
}

enum WorkRequestStatusCode {
  CREATED
  DIVISION_NOTIFIED
  INFO_REQUESTED_FROM_MARKETING
  INFO_REQUESTED_FROM_CLIENT
  CLIENT_INFO_PROVIDED
  MARKETING_INFO_PROVIDED
  LEADER_ASSIGNED
  MEMBER_REVIEW
  MEMBER_INFO_REQUESTED
  PM_LEAD_RESPONDED
  PM_MEMBER_SUBMITTED
  PM_REWORK_REQUESTED
  FORWARDED_TO_TMS
  ENGINEERING_REVISION_REQUESTED
  TMS_MEMBER_INFO_REQUESTED
  TMS_ASSIGNED
  DRAWING_IN_PROGRESS
  CHECKING_REVIEW
  APPROVAL_REVIEW
  ENGINEERING_LEAD_REVIEW
  FINAL_SUBMITTED_TO_MARKETING
  FINAL_SUBMITTED_TO_CLIENT
  CLIENT_REVISION_REQUESTED
  RETURNED_TO_DIVISION
  DIVISION_MEMBER_APPROVED
  DIVISION_MANAGER_APPROVED
  FORWARDED_TO_CCR
  HML_LISTED
  REJECTED
  @@map("work_request_status_code")
}

enum WorkflowActionCode {
  ADD_COMPANY
  ADD_DIVISION
  ADD_TEAM
  ADD_MEMBER
  ADD_PROJECT
  ADD_BID
  ADD_CLIENT_DOCUMENT
  ADD_WORK_REQUEST_DOCUMENT
  ADD_WORK_REQUEST
  ADD_WORK_REQUEST_NOTE
  REQUEST_WORKFLOW_INFO
  RESPOND_WORKFLOW_INFO
  REQUEST_INFO_FROM_MARKETING
  MARKETING_RETURN_TO_PM
  MARKETING_ESCALATE_TO_CLIENT
  CLIENT_PROVIDE_INFO
  MEMBER_REQUEST_INFO
  PM_LEAD_RESPOND_TO_MEMBER
  PM_MEMBER_SUBMIT
  PM_RETURN_TO_MEMBER
  ASSIGN_LEADER
  ASSIGN_MEMBER
  FORWARD_TO_TMS
  ASSIGN_TMS_CHAIN
  SUBMIT_DRAWING
  REVIEW_CHECKING_APPROVE
  REVIEW_CHECKING_REJECT
  REVIEW_APPROVAL_APPROVE
  REVIEW_APPROVAL_REJECT
  ENGINEERING_REQUEST_PM_REVISION
  TMS_MEMBER_REQUEST_LEAD
  TMS_LEAD_RESPOND_TO_MEMBER
  ENGINEERING_SUBMIT_TO_MARKETING
  MARKETING_SUBMIT_TO_CLIENT
  MARKETING_REQUEST_ENGINEERING_REVISION
  MARKETING_ROUTE_CLIENT_REVISION_TO_TMS
  MARKETING_SUBMIT_CLIENT_REVISION
  ENGINEERING_REQUEST_TMS_REVISION
  CLIENT_REQUEST_REVISION
  CLIENT_ACCEPT_FINAL
  CLIENT_REJECT_FINAL
  ORIGIN_MEMBER_APPROVE
  ORIGIN_MEMBER_REJECT
  ORIGIN_MANAGER_APPROVE
  FORWARD_TO_CCR
  SEND_BACKWARD
  LIST_FINAL_DOCUMENT
  DECIDE_BID_OUTCOME
  REQUEST_ARCHIVED_BID_REVIEW
  UPDATE_SETTINGS
  @@map("workflow_action_code")
}

enum WorkPriorityCode {
  High
  Medium
  Low
  @@map("work_priority_code")
}

enum AttachmentSourceTypeCode {
  TEXT
  FILE
  TEXT_AND_FILE
  METADATA
  @@map("attachment_source_type_code")
}

enum AttachmentFileGroupCode {
  PRIMARY
  WORKFLOW
  @@map("attachment_file_group_code")
}

enum DocumentGroupCode {
  MARKETING
  ENGINEERING
  CUSTOM
  @@map("document_group_code")
}

enum InfoRequestStatusCode {
  OPEN
  RESPONDED
  CANCELLED
  SUPERSEDED
  @@map("info_request_status_code")
}

enum RevisionRequestStatusCode {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  @@map("revision_request_status_code")
}

enum DecisionResultCode {
  APPROVED
  REJECTED
  ACCEPTED
  DECLINED
  REVISION_REQUESTED
  RETURNED
  @@map("decision_result_code")
}

enum BidOutcomeCode {
  WIN
  LOSE
  @@map("bid_outcome_code")
}

enum NotificationKindCode {
  PROJECT
  REQUEST
  SYSTEM
  @@map("notification_kind_code")
}

enum NotificationTargetViewCode {
  focus
  details
  @@map("notification_target_view_code")
}

enum DocumentLinkTypeCode {
  INITIAL_UPLOAD
  WORKFLOW_UPLOAD
  FINAL_PACKAGE
  CLIENT_REVISION
  REVISION_RESPONSE
  REGISTRY_LISTED
  @@map("document_link_type_code")
}

enum FolderTypeCode {
  ROOT
  CATEGORY
  DATE
  DATE_REVISION
  CUSTOM
  @@map("folder_type_code")
}

enum OptionTypeCode {
  POL
  POD
  CARGO_CODE
  VESSEL_CODE
  PROJECT_INFO_CATEGORY
  WORK_REQUEST_TYPE
  DOCUMENT_CATEGORY
  ATTACHMENT_CATEGORY
  @@map("option_type_code")
}

enum AssignmentTypeCode {
  PM_LEADER
  PM_MEMBER
  TMS_MANAGER
  TMS_DRAWING
  TMS_CHECKING
  TMS_APPROVAL
  @@map("assignment_type_code")
}

enum AuditEntityTypeCode {
  PROJECT
  WORK_REQUEST
  DOCUMENT
  TEAM
  MEMBER
  CLIENT
  COMPANY
  SETTING
  NOTIFICATION
  @@map("audit_entity_type_code")
}

model Tenant {
  id String @id @db.Uuid @map("id")
  name String @db.VarChar(180) @map("name")
  slug String @unique @db.VarChar(100) @map("slug")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt DateTime @default(now()) @db.Timestamp(6) @map("updated_at")

  users User[]
  userRoles UserRole[]
  actorProfiles ActorProfile[]
  authSessions AuthSession[]
  passwordResetTokens PasswordResetToken[]
  company Company?
  divisions Division[]
  members Member[]
  teams Team[]
  teamMembers TeamMember[]
  clients Client[]
  clientContacts ClientContact[]
  portalConfigs PortalConfig[]
  optionValues OptionValue[]
  documentCodeOptions DocumentCodeOption[]
  sourceChannels SourceChannel[]
  projects Project[]
  projectStatusEvents ProjectStatusEvent[]
  bidDetails BidDetail[]
  projectCredentialDeliveries ProjectCredentialDelivery[]
  bidOutcomeEvents BidOutcomeEvent[]
  projectConversionEvents ProjectConversionEvent[]
  archivedBidReviewRequests ArchivedBidReviewRequest[]
  documentCategories DocumentCategory[]
  documents Document[]
  documentVersions DocumentVersion[]
  documentFolders DocumentFolder[]
  documentVersionFolderLocations DocumentVersionFolderLocation[]
  documentVersionLinks DocumentVersionLink[]
  workRequestCategories WorkRequestCategory[]
  workRequestAttachmentCategories WorkRequestAttachmentCategory[]
  workflowTransitions WorkflowTransition[]
  workflowActionRolePermissions WorkflowActionRolePermission[]
  workRequests WorkRequest[]
  workRequestAssignments WorkRequestAssignment[]
  workRequestAuditLogs WorkRequestAuditLog[]
  workRequestNotes WorkRequestNote[]
  workRequestAuditAttachments WorkRequestAuditAttachment[]
  workflowInfoRequests WorkflowInfoRequest[]
  workflowInfoResponses WorkflowInfoResponse[]
  workRequestRevisionRequests WorkRequestRevisionRequest[]
  workRequestRevisionDocuments WorkRequestRevisionDocument[]
  workRequestRevisionSubmissions WorkRequestRevisionSubmission[]
  workRequestRevisionSubmissionDocuments WorkRequestRevisionSubmissionDocument[]
  workRequestDecisions WorkRequestDecision[]
  registryDocuments RegistryDocument[]
  notifications Notification[]
  notificationRecipients NotificationRecipient[]
  systemAuditLogs SystemAuditLog[]
  outboxMessages OutboxMessage[]
  processedEvents ProcessedEvent[]
  @@map("tenants")
}

model User {
  tenantId String @db.Uuid @map("tenant_id")
  id String @id @db.Uuid @map("id")
  fullName String @db.VarChar(160) @map("full_name")
  email String @unique @db.VarChar(255) @map("email")
  passwordHash String? @db.VarChar(255) @map("password_hash")
  country String? @db.VarChar(100) @map("country")
  phone String? @db.VarChar(60) @map("phone")
  avatarUrl String? @db.Text @map("avatar_url")
  isActive Boolean @default(true) @map("is_active")
  lastLoginAt DateTime? @db.Timestamp(6) @map("last_login_at")
  createdAt DateTime @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt DateTime @default(now()) @db.Timestamp(6) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRolesByUserId UserRole[] @relation("UserRolesUserIdUsers")
  userRolesByAssignedByUserId UserRole[] @relation("UserRolesAssignedByUserIdUsers")
  actorProfilesByUserId ActorProfile[] @relation("ActorProfilesUserIdUsers")
  authSessionsByUserId AuthSession[] @relation("AuthSessionsUserIdUsers")
  passwordResetTokensByUserId PasswordResetToken[] @relation("PasswordResetTokensUserIdUsers")
  membersByUserId Member[] @relation("MembersUserIdUsers")
  clientContactsByUserId ClientContact[] @relation("ClientContactsUserIdUsers")
  @@index([tenantId])
  @@map("users")
}

model Role {
  id String @id @db.Uuid @map("id")
  code ActorRoleCode @unique @map("code")
  name String @db.VarChar(120) @map("name")
  description String? @db.Text @map("description")
  isSystemRole Boolean @default(true) @map("is_system_role")
  createdAt DateTime @default(now()) @db.Timestamp(6) @map("created_at")

  userRolesByRoleId UserRole[] @relation("UserRolesRoleIdRoles")
  actorProfilesByRoleId ActorProfile[] @relation("ActorProfilesRoleIdRoles")
  workflowTransitionsByFromRoleId WorkflowTransition[] @relation("WorkflowTransitionsFromRoleIdRoles")
  workflowTransitionsByTargetRoleId WorkflowTransition[] @relation("WorkflowTransitionsTargetRoleIdRoles")
  workflowActionRolePermissionsByRoleId WorkflowActionRolePermission[] @relation("WorkflowActionRolePermissionsRoleIdRoles")
  workflowInfoRequestsByRequestedByRoleId WorkflowInfoRequest[] @relation("WorkflowInfoRequestsRequestedByRoleIdRoles")
  workflowInfoRequestsByTargetRoleId WorkflowInfoRequest[] @relation("WorkflowInfoRequestsTargetRoleIdRoles")
  workRequestRevisionRequestsByRequestedToRoleId WorkRequestRevisionRequest[] @relation("WorkRequestRevisionRequestsRequestedToRoleIdRoles")
  @@map("roles")
}

model UserRole {
  tenantId String @db.Uuid @map("tenant_id")
  id String @id @db.Uuid @map("id")
  userId String @db.Uuid @map("user_id")
  roleId String @db.Uuid @map("role_id")
  assignedByUserId String? @db.Uuid @map("assigned_by_user_id")
  assignedAt DateTime @default(now()) @db.Timestamp(6) @map("assigned_at")
  revokedAt DateTime? @db.Timestamp(6) @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user User @relation("UserRolesUserIdUsers", fields: [userId], references: [id])
  role Role @relation("UserRolesRoleIdRoles", fields: [roleId], references: [id])
  assignedByUser User? @relation("UserRolesAssignedByUserIdUsers", fields: [assignedByUserId], references: [id])
  @@index([userId, roleId, revokedAt])
  @@index([tenantId])
  @@map("user_roles")
}

model ActorProfile {
  tenantId String @db.Uuid @map("tenant_id")
  id String @id @db.Uuid @map("id")
  userId String? @db.Uuid @map("user_id")
  roleId String @db.Uuid @map("role_id")
  memberId String? @db.Uuid @map("member_id")
  clientContactId String? @db.Uuid @map("client_contact_id")
  label String @db.VarChar(180) @map("label")
  isDefault Boolean @default(false) @map("is_default")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamp(6) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user User? @relation("ActorProfilesUserIdUsers", fields: [userId], references: [id])
  role Role @relation("ActorProfilesRoleIdRoles", fields: [roleId], references: [id])
  member Member? @relation("ActorProfilesMemberIdMembers", fields: [memberId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Cascade)
  clientContact ClientContact? @relation("ActorProfilesClientContactIdClientContacts", fields: [clientContactId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Cascade)
  projectsByCreatedByActorId Project[] @relation("ProjectsCreatedByActorIdActorProfiles")
  projectStatusEventsByChangedByActorId ProjectStatusEvent[] @relation("ProjectStatusEventsChangedByActorIdActorProfiles")
  projectCredentialDeliveriesBySentByActorId ProjectCredentialDelivery[] @relation("ProjectCredentialDeliveriesSentByActorIdActorProfiles")
  bidOutcomeEventsByDecidedByActorId BidOutcomeEvent[] @relation("BidOutcomeEventsDecidedByActorIdActorProfiles")
  projectConversionEventsByConvertedByActorId ProjectConversionEvent[] @relation("ProjectConversionEventsConvertedByActorIdActorProfiles")
  archivedBidReviewRequestsByRequestedByActorId ArchivedBidReviewRequest[] @relation("ArchivedBidReviewRequestsRequestedByActorIdActorProfiles")
  documentsByCreatedByActorId Document[] @relation("DocumentsCreatedByActorIdActorProfiles")
  documentVersionsByUploadedByActorId DocumentVersion[] @relation("DocumentVersionsUploadedByActorIdActorProfiles")
  documentVersionLinksByLinkedByActorId DocumentVersionLink[] @relation("DocumentVersionLinksLinkedByActorIdActorProfiles")
  workRequestsByCreatedByActorId WorkRequest[] @relation("WorkRequestsCreatedByActorIdActorProfiles")
  workRequestAssignmentsByAssignedByActorId WorkRequestAssignment[] @relation("WorkRequestAssignmentsAssignedByActorIdActorProfiles")
  workRequestAuditLogsByPerformedByActorId WorkRequestAuditLog[] @relation("WorkRequestAuditLogsPerformedByActorIdActorProfiles")
  workRequestNotesByCreatedByActorId WorkRequestNote[] @relation("WorkRequestNotesCreatedByActorIdActorProfiles")
  workflowInfoRequestsByRequestedByActorId WorkflowInfoRequest[] @relation("WorkflowInfoRequestsRequestedByActorIdActorProfiles")
  workflowInfoResponsesByRespondedByActorId WorkflowInfoResponse[] @relation("WorkflowInfoResponsesRespondedByActorIdActorProfiles")
  workRequestRevisionRequestsByRequestedByActorId WorkRequestRevisionRequest[] @relation("WorkRequestRevisionRequestsRequestedByActorIdActorProfiles")
  workRequestRevisionDocumentsByAttachedByActorId WorkRequestRevisionDocument[] @relation("WorkRequestRevisionDocumentsAttachedByActorIdActorProfiles")
  workRequestRevisionSubmissionsBySubmittedByActorId WorkRequestRevisionSubmission[] @relation("WorkRequestRevisionSubmissionsSubmittedByActorIdActorProfiles")
  workRequestDecisionsByDecidedByActorId WorkRequestDecision[] @relation("WorkRequestDecisionsDecidedByActorIdActorProfiles")
  registryDocumentsByListedByActorId RegistryDocument[] @relation("RegistryDocumentsListedByActorIdActorProfiles")
  registryDocumentsByRemovedByActorId RegistryDocument[] @relation("RegistryDocumentsRemovedByActorIdActorProfiles")
  notificationsByTriggeredByActorId Notification[] @relation("NotificationsTriggeredByActorIdActorProfiles")
  notificationRecipientsByActorId NotificationRecipient[] @relation("NotificationRecipientsActorIdActorProfiles")
  systemAuditLogsByPerformedByActorId SystemAuditLog[] @relation("SystemAuditLogsPerformedByActorIdActorProfiles")
  outboxMessagesByActorId OutboxMessage[] @relation("OutboxMessagesActorIdActorProfiles")
  @@unique([id, tenantId])
  @@index([memberId, tenantId])
  @@index([clientContactId, tenantId])
  @@index([tenantId])
  @@map("actor_profiles")
}

model AuthSession {
  tenantId String @db.Uuid @map("tenant_id")
  id String @id @db.Uuid @map("id")
  userId String @db.Uuid @map("user_id")
  refreshTokenHash String @db.VarChar(255) @map("refresh_token_hash")
  previousRefreshTokenHash String? @db.VarChar(255) @map("previous_refresh_token_hash")
  ipAddress String? @db.VarChar(80) @map("ip_address")
  userAgent String? @db.Text @map("user_agent")
  expiresAt DateTime @db.Timestamp(6) @map("expires_at")
  absoluteExpiresAt DateTime @db.Timestamp(6) @map("absolute_expires_at")
  revokedAt DateTime? @db.Timestamp(6) @map("revoked_at")
  createdAt DateTime @default(now()) @db.Timestamp(6) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user User @relation("AuthSessionsUserIdUsers", fields: [userId], references: [id])
  consumedRefreshTokens AuthSessionConsumedRefreshToken[]
  @@index([userId])
  @@index([expiresAt])
  @@index([previousRefreshTokenHash])
  @@index([tenantId])
  @@map("auth_sessions")
}

model AuthSessionConsumedRefreshToken {
  tenantId String @db.Uuid @map("tenant_id")
  id String @id @db.Uuid @map("id")
  sessionId String @db.Uuid @map("session_id")
  tokenHash String @db.VarChar(255) @map("token_hash")
  consumedAt DateTime @default(now()) @db.Timestamp(6) @map("consumed_at")

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([tenantId, tokenHash])
  @@index([sessionId])
  @@index([tenantId])
  @@map("auth_session_consumed_refresh_tokens")
}

model PasswordResetToken {
  tenantId String @db.Uuid @map("tenant_id")
  id String @id @db.Uuid @map("id")
  userId String @db.Uuid @map("user_id")
  tokenHash String @db.VarChar(255) @map("token_hash")
  expiresAt DateTime @db.Timestamp(6) @map("expires_at")
  usedAt DateTime? @db.Timestamp(6) @map("used_at")
  createdAt DateTime @default(now()) @db.Timestamp(6) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user User @relation("PasswordResetTokensUserIdUsers", fields: [userId], references: [id])
  @@unique([tenantId, tokenHash])
  @@index([userId])
  @@index([tenantId])
  @@map("password_reset_tokens")
}

model CompanyType {
  id String @id @db.Uuid @map("id")
  name String @unique @db.VarChar(100) @map("name")
  description String? @db.Text @map("description")

  companiesByCompanyTypeId Company[] @relation("CompaniesCompanyTypeIdCompanyTypes")
  @@map("company_types")
}

model Company {
  tenantId String @db.Uuid @map("tenant_id")
  id String @id @db.Uuid @map("id")
  name String @db.VarChar(180) @map("name")
  abbr String @db.VarChar(30) @map("abbr")
  workspaceSlug String @unique @db.VarChar(100) @map("workspace_slug")
  companyTypeId String? @db.Uuid @map("company_type_id")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt DateTime @default(now()) @db.Timestamp(6) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  companyType CompanyType? @relation("CompaniesCompanyTypeIdCompanyTypes", fields: [companyTypeId], references: [id])
  divisionsByCompanyId Division[] @relation("DivisionsCompanyIdCompanies")
  membersByCompanyId Member[] @relation("MembersCompanyIdCompanies")
  teamsByCompanyId Team[] @relation("TeamsCompanyIdCompanies")
  clientsByCompanyId Client[] @relation("ClientsCompanyIdCompanies")
  @@unique([tenantId, abbr])
  @@index([name])
  @@unique([tenantId])
  @@map("companies")
}

model DivisionType {
  id String @id @db.Uuid @map("id")
  name String @unique @db.VarChar(100) @map("name")
  description String? @db.Text @map("description")

  divisionsByDivisionTypeId Division[] @relation("DivisionsDivisionTypeIdDivisionTypes")
  @@map("division_types")
}

model Division {
  tenantId String @db.Uuid @map("tenant_id")
  id String @id @db.Uuid @map("id")
  companyId String @db.Uuid @map("company_id")
  name String @db.VarChar(180) @map("name")
  abbr String @db.VarChar(30) @map("abbr")
  divisionTypeId String? @db.Uuid @map("division_type_id")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt DateTime @default(now()) @db.Timestamp(6) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation("DivisionsCompanyIdCompanies", fields: [companyId], references: [id])
  divisionType DivisionType? @relation("DivisionsDivisionTypeIdDivisionTypes", fields: [divisionTypeId], references: [id])
  membersByDivisionId Member[] @relation("MembersDivisionIdDivisions")
  teamsByDivisionId Team[] @relation("TeamsDivisionIdDivisions")
  projectsByOriginDivisionId Project[] @relation("ProjectsOriginDivisionIdDivisions")
  workRequestsByAssignedDivisionId WorkRequest[] @relation("WorkRequestsAssignedDivisionIdDivisions")
  workRequestsByOriginDivisionId WorkRequest[] @relation("WorkRequestsOriginDivisionIdDivisions")
  @@unique([id, tenantId])
  @@unique([id, tenantId, companyId])
  @@unique([tenantId, companyId, abbr])
  @@index([companyId, name])
  @@index([tenantId])
  @@map("divisions")
}

model Member {
  tenantId String @db.Uuid @map("tenant_id")
  id String @id @db.Uuid @map("id")
  userId String? @db.Uuid @map("user_id")
  companyId String @db.Uuid @map("company_id")
  divisionId String @db.Uuid @map("division_id")
  name String @db.VarChar(160) @map("name")
  email String @db.VarChar(255) @map("email")
  roleTitle String @db.VarChar(140) @map("role_title")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt DateTime @default(now()) @db.Timestamp(6) @map("updated_at")

  actorProfilesByMemberId ActorProfile[] @relation("ActorProfilesMemberIdMembers")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user User? @relation("MembersUserIdUsers", fields: [userId], references: [id])
  company Company @relation("MembersCompanyIdCompanies", fields: [companyId], references: [id])
  division Division @relation("MembersDivisionIdDivisions", fields: [divisionId, tenantId, companyId], references: [id, tenantId, companyId])
  teamsByLeadMemberId Team[] @relation("TeamsLeadMemberIdMembers")
  teamMembersByMemberId TeamMember[] @relation("TeamMembersMemberIdMembers")
  workRequestAssignmentsByMemberId WorkRequestAssignment[] @relation("WorkRequestAssignmentsMemberIdMembers")
  workflowInfoRequestsByRequestedByMemberId WorkflowInfoRequest[] @relation("WorkflowInfoRequestsRequestedByMemberIdMembers")
  workflowInfoRequestsByTargetMemberId WorkflowInfoRequest[] @relation("WorkflowInfoRequestsTargetMemberIdMembers")
  workRequestRevisionRequestsByRequestedToMemberId WorkRequestRevisionRequest[] @relation("WorkRequestRevisionRequestsRequestedToMemberIdMembers")
  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@index([companyId])
  @@index([divisionId])
  @@index([divisionId, tenantId, companyId])
  @@index([tenantId])
  @@map("members")
}

model Team {
  tenantId String @db.Uuid @map("tenant_id")
  id String @id @db.Uuid @map("id")
  companyId String @db.Uuid @map("company_id")
  divisionId String @db.Uuid @map("division_id")
  name String @db.VarChar(180) @map("name")
  leadMemberId String? @db.Uuid @map("lead_member_id")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt DateTime @default(now()) @db.Timestamp(6) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation("TeamsCompanyIdCompanies", fields: [companyId], references: [id])
  division Division @relation("TeamsDivisionIdDivisions", fields: [divisionId, tenantId, companyId], references: [id, tenantId, companyId])
  leadMember Member? @relation("TeamsLeadMemberIdMembers", fields: [leadMemberId], references: [id])
  teamMembersByTeamId TeamMember[] @relation("TeamMembersTeamIdTeams")
  @@unique([tenantId, divisionId, name])
  @@index([divisionId, tenantId, companyId])
  @@index([tenantId])
  @@map("teams")
}

model TeamMember {
  tenantId String @db.Uuid @map("tenant_id")
  id String @id @db.Uuid @map("id")
  teamId String @db.Uuid @map("team_id")
  memberId String @db.Uuid @map("member_id")
  teamRole String? @db.VarChar(100) @map("team_role")
  joinedAt DateTime @default(now()) @db.Timestamp(6) @map("joined_at")
  leftAt DateTime? @db.Timestamp(6) @map("left_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  team Team @relation("TeamMembersTeamIdTeams", fields: [teamId], references: [id])
  member Member @relation("TeamMembersMemberIdMembers", fields: [memberId], references: [id])
  @@index([teamId, memberId, leftAt])
  @@index([tenantId])
  @@map("team_members")
}

model Client {
  tenantId String @db.Uuid @map("tenant_id")
