  id                      String    @id @map("id") @db.Uuid
  projectId               String    @map("project_id") @db.Uuid
  workRequestId           String    @map("work_request_id") @db.Uuid
  documentId              String?   @map("document_id") @db.Uuid
  listedDocumentVersionId String?   @map("listed_document_version_id") @db.Uuid
  listedCategoryId        String?   @map("listed_category_id") @db.Uuid
  listedByActorId         String    @map("listed_by_actor_id") @db.Uuid
  listedAt                DateTime  @default(now()) @map("listed_at") @db.Timestamp(6)
  registryNote            String?   @map("registry_note") @db.Text
  removedAt               DateTime? @map("removed_at") @db.Timestamp(6)
  removedByActorId        String?   @map("removed_by_actor_id") @db.Uuid

  project               Project           @relation("RegistryDocumentsProjectIdProjects", fields: [projectId], references: [id])
  workRequest           WorkRequest       @relation("RegistryDocumentsWorkRequestIdWorkRequests", fields: [workRequestId], references: [id])
  document              Document?         @relation("RegistryDocumentsDocumentIdDocuments", fields: [documentId], references: [id])
