model Notification {
  tenantId           String                      @map("tenant_id") @db.Uuid
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id                 String                      @id @map("id") @db.Uuid
  notificationKind   NotificationKindCode        @map("notification_kind")
  projectId          String?                     @map("project_id") @db.Uuid
  workRequestId      String?                     @map("work_request_id") @db.Uuid
  auditLogId         String?                     @map("audit_log_id") @db.Uuid
  title              String                      @map("title") @db.VarChar(260)
  subtitle           String?                     @map("subtitle") @db.VarChar(260)
  roleMessage        String?                     @map("role_message") @db.VarChar(260)
  targetView         NotificationTargetViewCode? @map("target_view")
  triggeredByActorId String?                     @map("triggered_by_actor_id") @db.Uuid
  triggeredByLabel   String?                     @map("triggered_by_label") @db.VarChar(180)
  triggeredAt        DateTime                    @default(now()) @map("triggered_at") @db.Timestamp(6)
  expiresAt          DateTime?                   @map("expires_at") @db.Timestamp(6)

  project                                Project?                @relation("NotificationsProjectIdProjects", fields: [projectId], references: [id])
  workRequest                            WorkRequest?            @relation("NotificationsWorkRequestIdWorkRequests", fields: [workRequestId], references: [id])
  auditLog                               WorkRequestAuditLog?    @relation("NotificationsAuditLogIdWorkRequestAuditLogs", fields: [auditLogId], references: [id])
  triggeredByActor                       ActorProfile?           @relation("NotificationsTriggeredByActorIdActorProfiles", fields: [triggeredByActorId], references: [id])
  notificationRecipientsByNotificationId NotificationRecipient[] @relation("NotificationRecipientsNotificationIdNotifications")

  @@index([projectId])
  @@index([workRequestId])
  @@index([triggeredAt])
  @@index([tenantId])
  @@map("notifications")
}

model NotificationRecipient {
  tenantId       String    @map("tenant_id") @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id             String    @id @map("id") @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  actorId        String    @map("actor_id") @db.Uuid
  deliveredAt    DateTime  @default(now()) @map("delivered_at") @db.Timestamp(6)
  readAt         DateTime? @map("read_at") @db.Timestamp(6)
  openedAt       DateTime? @map("opened_at") @db.Timestamp(6)
  dismissedAt    DateTime? @map("dismissed_at") @db.Timestamp(6)

  notification Notification @relation("NotificationRecipientsNotificationIdNotifications", fields: [notificationId], references: [id])
  actor        ActorProfile @relation("NotificationRecipientsActorIdActorProfiles", fields: [actorId], references: [id])

  @@unique([tenantId, notificationId, actorId])
  @@index([actorId, readAt])
  @@index([tenantId])
  @@map("notification_recipients")
}

