generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ActorRoleCode {
  system_admin
  ccr_coordinator
  division_head
  division_lead
  team_lead
  division_member
  tms_manager
  tms_drawing
  tms_checking
  tms_approval
  client_owner

  @@map("actor_role_code")
}

enum CustomRoleScope {
  member
  division
  company
  client_contact
  client

  @@map("custom_role_scope")
}

enum WorkspaceTypeCode {
  BID
  PROJECT

  @@map("workspace_type_code")
}

enum ProjectStatusCode {
  DRAFT
  BIDDING
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("project_status_code")
}

enum WorkRequestStatusCode {
  CREATED
  DIVISION_NOTIFIED
  INFO_REQUESTED_FROM_MARKETING
  INFO_REQUESTED_FROM_CLIENT
  CLIENT_INFO_PROVIDED
  MARKETING_INFO_PROVIDED
  LEADER_ASSIGNED
  MEMBER_REVIEW
  MEMBER_INFO_REQUESTED
  PM_LEAD_RESPONDED
  PM_MEMBER_SUBMITTED
  PM_REWORK_REQUESTED
  FORWARDED_TO_TMS
  ENGINEERING_REVISION_REQUESTED
  TMS_MEMBER_INFO_REQUESTED
  TMS_ASSIGNED
  DRAWING_IN_PROGRESS
  CHECKING_REVIEW
  APPROVAL_REVIEW
  ENGINEERING_LEAD_REVIEW
  FINAL_SUBMITTED_TO_MARKETING
  FINAL_SUBMITTED_TO_CLIENT
  CLIENT_REVISION_REQUESTED
  RETURNED_TO_DIVISION
  DIVISION_MEMBER_APPROVED
  DIVISION_MANAGER_APPROVED
  FORWARDED_TO_CCR
  HML_LISTED
  REJECTED

  @@map("work_request_status_code")
}

enum WorkflowActionCode {
  ADD_COMPANY
  ADD_DIVISION
  ADD_TEAM
  ADD_MEMBER
  ADD_PROJECT
  ADD_BID
  VIEW_BID
  UPDATE_BID
  VIEW_PROJECT
  UPDATE_PROJECT
  ADD_CLIENT_DOCUMENT
  ADD_WORK_REQUEST_DOCUMENT
  ADD_WORK_REQUEST
  ADD_WORK_REQUEST_NOTE
  REQUEST_WORKFLOW_INFO
  RESPOND_WORKFLOW_INFO
  REQUEST_INFO_FROM_MARKETING
  MARKETING_RETURN_TO_PM
  MARKETING_ESCALATE_TO_CLIENT
  CLIENT_PROVIDE_INFO
  MEMBER_REQUEST_INFO
  PM_LEAD_RESPOND_TO_MEMBER
  PM_MEMBER_SUBMIT
  PM_RETURN_TO_MEMBER
  ASSIGN_LEADER
  ASSIGN_MEMBER
  FORWARD_TO_TMS
  ASSIGN_TMS_CHAIN
  SUBMIT_DRAWING
  REVIEW_CHECKING_APPROVE
  REVIEW_CHECKING_REJECT
  REVIEW_APPROVAL_APPROVE
  REVIEW_APPROVAL_REJECT
  ENGINEERING_REQUEST_PM_REVISION
  TMS_MEMBER_REQUEST_LEAD
  TMS_LEAD_RESPOND_TO_MEMBER
  ENGINEERING_SUBMIT_TO_MARKETING
  MARKETING_SUBMIT_TO_CLIENT
  MARKETING_REQUEST_ENGINEERING_REVISION
  MARKETING_ROUTE_CLIENT_REVISION_TO_TMS
  MARKETING_SUBMIT_CLIENT_REVISION
  ENGINEERING_REQUEST_TMS_REVISION
  CLIENT_REQUEST_REVISION
  CLIENT_ACCEPT_FINAL
  CLIENT_REJECT_FINAL
  ORIGIN_MEMBER_APPROVE
  ORIGIN_MEMBER_REJECT
  ORIGIN_MANAGER_APPROVE
  FORWARD_TO_CCR
  SEND_BACKWARD
  LIST_FINAL_DOCUMENT
  DECIDE_BID_OUTCOME
  REQUEST_ARCHIVED_BID_REVIEW
  UPDATE_SETTINGS
  MANAGE_CLIENT
  MANAGE_CLIENT_CONTACT
  MANAGE_CLIENT_PORTAL_ACCESS
  MANAGE_GENERAL_DOCUMENT_CODES
  MANAGE_DESIGNATIONS
  VIEW_WORK_REQUEST
  UPDATE_WORK_REQUEST
  WR_ASSIGN_DIVISION
  WR_ASSIGN_TEAM
  WR_ASSIGN_MEMBER
  WR_SUBMIT
  WR_TEAM_LEAD_APPROVE
  WR_TEAM_LEAD_REQUEST_REVISION
  WR_DIVISION_LEAD_APPROVE
  WR_DIVISION_LEAD_REQUEST_REVISION
  WR_DIVISION_HEAD_APPROVE
  WR_DIVISION_HEAD_REQUEST_REVISION

  @@map("workflow_action_code")
}

enum BidStatusCode {
  BIDDING

  @@map("bid_status_code")
}

enum WorkPriorityCode {
  High
  Medium
  Low

  @@map("work_priority_code")
}

/// Module 10 owns this fixed request value.  It intentionally has no
/// reference-data model, seed, or lifecycle.
enum WorkRequestV1PriorityCode {
  Low
  Medium
  High

  @@map("work_request_v1_priority_code")
}

/// Module 10 state is derived from the latest WorkRequestV1Event row; this
/// enum is deliberately separate from the legacy work_request_status_code.
enum WorkRequestV1StateCode {
  CREATED
  DIVISION_ASSIGNED
  TEAM_ASSIGNED
  MEMBER_ASSIGNED
  MEMBER_SUBMITTED
  TEAM_LEAD_APPROVED
  DIVISION_LEAD_APPROVED
  DIVISION_HEAD_APPROVED

  @@map("work_request_v1_state_code")
}

enum WorkRequestV1AssignmentLevelCode {
  DIVISION
  TEAM
  MEMBER

  @@map("work_request_v1_assignment_level_code")
}

enum AttachmentSourceTypeCode {
  TEXT
  FILE
  TEXT_AND_FILE
  METADATA

  @@map("attachment_source_type_code")
}

enum AttachmentFileGroupCode {
  PRIMARY
  WORKFLOW

  @@map("attachment_file_group_code")
}

enum DocumentGroupCode {
  GENERAL
  MARKETING
  ETC
  ENGINEERING
  PROJECT_MANAGEMENT_OPERATION
  CUSTOM

  @@map("document_group_code")
}

enum InfoRequestStatusCode {
  OPEN
  RESPONDED
  CANCELLED
  SUPERSEDED

  @@map("info_request_status_code")
}

enum RevisionRequestStatusCode {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED

  @@map("revision_request_status_code")
}

enum DecisionResultCode {
  APPROVED
  REJECTED
  ACCEPTED
  DECLINED
  REVISION_REQUESTED
  RETURNED

  @@map("decision_result_code")
}

enum BidOutcomeCode {
  WIN
  LOSE

  @@map("bid_outcome_code")
}

enum NotificationKindCode {
  PROJECT
  REQUEST
  SYSTEM

  @@map("notification_kind_code")
}

enum NotificationTargetViewCode {
  focus
  details

  @@map("notification_target_view_code")
}

enum DocumentLinkTypeCode {
  INITIAL_UPLOAD
  WORKFLOW_UPLOAD
  FINAL_PACKAGE
  CLIENT_REVISION
  REVISION_RESPONSE
  REGISTRY_LISTED

  @@map("document_link_type_code")
}

enum FolderTypeCode {
  ROOT
  CATEGORY
  DATE
  DATE_REVISION
  CUSTOM

  @@map("folder_type_code")
}

enum OptionTypeCode {
  POL
  POD
  CARGO_CODE
  VESSEL_CODE
  PROJECT_INFO_CATEGORY
  WORK_REQUEST_TYPE
  DOCUMENT_CATEGORY
  ATTACHMENT_CATEGORY

  @@map("option_type_code")
}

enum AssignmentTypeCode {
  PM_LEADER
  PM_MEMBER
  TMS_MANAGER
  TMS_DRAWING
  TMS_CHECKING
  TMS_APPROVAL

  @@map("assignment_type_code")
}

enum AuditEntityTypeCode {
  PROJECT
  WORK_REQUEST
  DOCUMENT
  TEAM
  MEMBER
  CLIENT
  COMPANY
  SETTING
  NOTIFICATION

  @@map("audit_entity_type_code")
}

model Tenant {
  id        String   @id @map("id") @db.Uuid
  name      String   @map("name") @db.VarChar(180)
  slug      String   @unique @map("slug") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  users                                     User[]
  customRoles                               Role[]                                     @relation("CustomRolesTenant")
  userRoles                                 UserRole[]
  actorProfiles                             ActorProfile[]
  authSessions                              AuthSession[]
  passwordResetTokens                       PasswordResetToken[]
  company                                   Company?
  divisions                                 Division[]
  members                                   Member[]
  divisionLeads                             DivisionLead[]
  teams                                     Team[]
  teamMembers                               TeamMember[]
  clients                                   Client[]
  clientContacts                            ClientContact[]
  portalConfigs                             PortalConfig[]
  optionValues                              OptionValue[]
  documentCodes                             DocumentCodeOption[]
  designations                              Designation[]
  sourceChannels                            SourceChannel[]
  projects                                  Project[]
  directProjects                            DirectProject[]
  bids                                      Bid[]
  bidStatusEvents                           BidStatusEvent[]
  bidDocuments                              BidDocument[]
  bidDocumentVersions                       BidDocumentVersion[]
  bidDocumentClassificationEvents           BidDocumentClassificationEvent[]
  businessNameClaims                        BusinessNameClaim[]
  projectStatusEvents                       ProjectStatusEvent[]
  directProjectStatusEvents                 DirectProjectStatusEvent[]
  directProjectDocuments                    DirectProjectDocument[]
  directProjectDocumentVersions             DirectProjectDocumentVersion[]
  directProjectDocumentClassificationEvents DirectProjectDocumentClassificationEvent[]
  workRequestsV1                            WorkRequestV1[]
  workRequestV1Assignments                  WorkRequestV1Assignment[]
  workRequestV1Events                       WorkRequestV1Event[]
  workRequestV1Documents                    WorkRequestV1Document[]
  workRequestV1DocumentVersions             WorkRequestV1DocumentVersion[]
  workRequestV1DocumentClassificationEvents WorkRequestV1DocumentClassificationEvent[]
  workRequestV1InfoRequests                 WorkRequestV1InfoRequest[]
  workRequestV1InfoResponses                WorkRequestV1InfoResponse[]
  bidDetails                                BidDetail[]
  projectCredentialDeliveries               ProjectCredentialDelivery[]
  bidOutcomeEvents                          BidOutcomeEvent[]
  projectConversionEvents                   ProjectConversionEvent[]
  archivedBidReviewRequests                 ArchivedBidReviewRequest[]
  documentCategories                        DocumentCategory[]
  documents                                 Document[]
  documentVersions                          DocumentVersion[]
  documentFolders                           DocumentFolder[]
  documentVersionFolderLocations            DocumentVersionFolderLocation[]
  documentVersionLinks                      DocumentVersionLink[]
  workRequestCategories                     WorkRequestCategory[]
  workRequestAttachmentCategories           WorkRequestAttachmentCategory[]
  workflowTransitions                       WorkflowTransition[]
  workflowActionRolePermissions             WorkflowActionRolePermission[]
  workRequests                              WorkRequest[]
  workRequestAssignments                    WorkRequestAssignment[]
  workRequestAuditLogs                      WorkRequestAuditLog[]
  workRequestNotes                          WorkRequestNote[]
  workRequestAuditAttachments               WorkRequestAuditAttachment[]
  workflowInfoRequests                      WorkflowInfoRequest[]
  workflowInfoResponses                     WorkflowInfoResponse[]
  workRequestRevisionRequests               WorkRequestRevisionRequest[]
  workRequestRevisionDocuments              WorkRequestRevisionDocument[]
  workRequestRevisionSubmissions            WorkRequestRevisionSubmission[]
  workRequestRevisionSubmissionDocuments    WorkRequestRevisionSubmissionDocument[]
  workRequestDecisions                      WorkRequestDecision[]
  registryDocuments                         RegistryDocument[]
  notifications                             Notification[]
  notificationRecipients                    NotificationRecipient[]
  systemAuditLogs                           SystemAuditLog[]
  outboxMessages                            OutboxMessage[]
  processedEvents                           ProcessedEvent[]
  bidStorageCleanupJobs                     BidStorageCleanupJob[]
  directProjectStorageCleanupJobs           DirectProjectStorageCleanupJob[]
  workRequestStorageCleanupJobs             WorkRequestStorageCleanupJob[]

  @@map("tenants")
}

model User {
  tenantId     String    @map("tenant_id") @db.Uuid
  id           String    @id @map("id") @db.Uuid
  fullName     String    @map("full_name") @db.VarChar(160)
  email        String    @unique @map("email") @db.VarChar(255)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  country      String?   @map("country") @db.VarChar(100)
  phone        String?   @map("phone") @db.VarChar(60)
  avatarUrl    String?   @map("avatar_url") @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)

  tenant                      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRolesByUserId           UserRole[]           @relation("UserRolesUserIdUsers")
  userRolesByAssignedByUserId UserRole[]           @relation("UserRolesAssignedByUserIdUsers")
  actorProfilesByUserId       ActorProfile[]       @relation("ActorProfilesUserIdUsers")
  authSessionsByUserId        AuthSession[]        @relation("AuthSessionsUserIdUsers")
  passwordResetTokensByUserId PasswordResetToken[] @relation("PasswordResetTokensUserIdUsers")
  membersByUserId             Member[]             @relation("MembersUserIdUsers")
  clientContactsByUserId      ClientContact[]      @relation("ClientContactsUserIdUsers")

  @@index([tenantId])
  @@map("users")
}

model Role {
  id           String           @id @map("id") @db.Uuid
  tenantId     String?          @map("tenant_id") @db.Uuid
  name         String           @map("name") @db.VarChar(120)
  description  String?          @map("description") @db.Text
  isSystemRole Boolean          @default(true) @map("is_system_role")
  customCode   String?          @map("custom_code") @db.VarChar(120)
  customScope  CustomRoleScope? @map("custom_scope")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamp(6)

  tenant                                  Tenant?                        @relation("CustomRolesTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  systemRole                              SystemRole?
  userRolesByRoleId                       UserRole[]                     @relation("UserRolesRoleIdRoles")
  actorProfilesByRoleId                   ActorProfile[]                 @relation("ActorProfilesRoleIdRoles")
  workflowActionRolePermissionsByRoleId   WorkflowActionRolePermission[] @relation("WorkflowActionRolePermissionsRoleIdRoles")
  workflowInfoRequestsByRequestedByRoleId WorkflowInfoRequest[]          @relation("WorkflowInfoRequestsRequestedByRoleIdRoles")

  @@unique([tenantId, customCode])
  @@index([tenantId])
  @@map("roles")
}

model SystemRole {
  roleId     String        @id @map("role_id") @db.Uuid
  systemCode ActorRoleCode @unique @map("system_code")

  role                                           Role                         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workflowTransitionsByFromRoleId                WorkflowTransition[]         @relation("WorkflowTransitionsFromRoleIdSystemRoles")
  workflowTransitionsByTargetRoleId              WorkflowTransition[]         @relation("WorkflowTransitionsTargetRoleIdSystemRoles")
  workflowInfoRequestsByTargetRoleId             WorkflowInfoRequest[]        @relation("WorkflowInfoRequestsTargetRoleIdSystemRoles")
  workRequestRevisionRequestsByRequestedToRoleId WorkRequestRevisionRequest[] @relation("WorkRequestRevisionRequestsRequestedToRoleIdSystemRoles")

  @@map("system_roles")
}

model UserRole {
  tenantId         String    @map("tenant_id") @db.Uuid
  id               String    @id @map("id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamp(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamp(6)

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User   @relation("UserRolesUserIdUsers", fields: [userId], references: [id])
  role           Role   @relation("UserRolesRoleIdRoles", fields: [roleId], references: [id])
  assignedByUser User?  @relation("UserRolesAssignedByUserIdUsers", fields: [assignedByUserId], references: [id])

  @@index([userId, roleId, revokedAt])
  @@index([tenantId])
  @@map("user_roles")
}

model ActorProfile {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @id @map("id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  memberId        String?  @map("member_id") @db.Uuid
  clientContactId String?  @map("client_contact_id") @db.Uuid
  label           String   @map("label") @db.VarChar(180)
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant                                                      Tenant                                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                                                        User?                                      @relation("ActorProfilesUserIdUsers", fields: [userId], references: [id])
  role                                                        Role                                       @relation("ActorProfilesRoleIdRoles", fields: [roleId], references: [id])
  member                                                      Member?                                    @relation("ActorProfilesMemberIdMembers", fields: [memberId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Cascade)
  clientContact                                               ClientContact?                             @relation("ActorProfilesClientContactIdClientContacts", fields: [clientContactId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Cascade)
  projectsByCreatedByActorId                                  Project[]                                  @relation("ProjectsCreatedByActorIdActorProfiles")
  directProjectsByCreatedByActorId                            DirectProject[]                            @relation("DirectProjectsCreatedByActorIdActorProfiles")
  bidsByCreatedByActorId                                      Bid[]                                      @relation("BidsCreatedByActorIdActorProfiles")
  bidStatusEventsByChangedByActorId                           BidStatusEvent[]                           @relation("BidStatusEventsChangedByActorIdActorProfiles")
  bidDocumentsByUploadedByActorId                             BidDocument[]                              @relation("BidDocumentsUploadedByActorIdActorProfiles")
  bidDocumentVersionsByUploadedByActorId                      BidDocumentVersion[]                       @relation("BidDocumentVersionsUploadedByActorIdActorProfiles")
  bidDocumentClassificationEventsByChangedByActorId           BidDocumentClassificationEvent[]           @relation("BidDocumentClassificationEventsChangedByActorIdActorProfiles")
  directProjectStatusEventsByChangedByActorId                 DirectProjectStatusEvent[]                 @relation("DirectProjectStatusEventsChangedByActorIdActorProfiles")
  directProjectDocumentsByUploadedByActorId                   DirectProjectDocument[]                    @relation("DirectProjectDocumentsUploadedByActorIdActorProfiles")
  directProjectDocumentVersionsByUploadedByActorId            DirectProjectDocumentVersion[]             @relation("DirectProjectDocumentVersionsUploadedByActorIdActorProfiles")
  directProjectDocumentClassificationEventsByChangedByActorId DirectProjectDocumentClassificationEvent[] @relation("DirectProjectDocumentClassificationEventsChangedByActorIdActorProfiles")
  workRequestsV1ByCreatedByActorId                            WorkRequestV1[]                            @relation("WorkRequestV1CreatedByActorIdActorProfiles")
  workRequestV1AssignmentsByAssignedByActorId                 WorkRequestV1Assignment[]                  @relation("WorkRequestV1AssignmentsAssignedByActorIdActorProfiles")
  workRequestV1EventsByPerformedByActorId                     WorkRequestV1Event[]                       @relation("WorkRequestV1EventsPerformedByActorIdActorProfiles")
  workRequestV1DocumentsByUploadedByActorId                   WorkRequestV1Document[]                    @relation("WorkRequestV1DocumentsUploadedByActorIdActorProfiles")
  workRequestV1DocumentVersionsByUploadedByActorId            WorkRequestV1DocumentVersion[]             @relation("WorkRequestV1DocumentVersionsUploadedByActorIdActorProfiles")
  workRequestV1DocumentClassificationEventsByChangedByActorId WorkRequestV1DocumentClassificationEvent[] @relation("WorkRequestV1DocumentClassificationEventsChangedByActorIdActorProfiles")
  workRequestV1InfoRequestsByRequestedByActorId               WorkRequestV1InfoRequest[]                 @relation("WorkRequestV1InfoRequestsRequestedByActorIdActorProfiles")
  workRequestV1InfoRequestsByTargetActorId                    WorkRequestV1InfoRequest[]                 @relation("WorkRequestV1InfoRequestsTargetActorIdActorProfiles")
  workRequestV1InfoResponsesByRespondedByActorId              WorkRequestV1InfoResponse[]                @relation("WorkRequestV1InfoResponsesRespondedByActorIdActorProfiles")
  projectStatusEventsByChangedByActorId                       ProjectStatusEvent[]                       @relation("ProjectStatusEventsChangedByActorIdActorProfiles")
  projectCredentialDeliveriesBySentByActorId                  ProjectCredentialDelivery[]                @relation("ProjectCredentialDeliveriesSentByActorIdActorProfiles")
  bidOutcomeEventsByDecidedByActorId                          BidOutcomeEvent[]                          @relation("BidOutcomeEventsDecidedByActorIdActorProfiles")
  projectConversionEventsByConvertedByActorId                 ProjectConversionEvent[]                   @relation("ProjectConversionEventsConvertedByActorIdActorProfiles")
  archivedBidReviewRequestsByRequestedByActorId               ArchivedBidReviewRequest[]                 @relation("ArchivedBidReviewRequestsRequestedByActorIdActorProfiles")
  documentsByCreatedByActorId                                 Document[]                                 @relation("DocumentsCreatedByActorIdActorProfiles")
  documentVersionsByUploadedByActorId                         DocumentVersion[]                          @relation("DocumentVersionsUploadedByActorIdActorProfiles")
  documentVersionLinksByLinkedByActorId                       DocumentVersionLink[]                      @relation("DocumentVersionLinksLinkedByActorIdActorProfiles")
  workRequestsByCreatedByActorId                              WorkRequest[]                              @relation("WorkRequestsCreatedByActorIdActorProfiles")
  workRequestAssignmentsByAssignedByActorId                   WorkRequestAssignment[]                    @relation("WorkRequestAssignmentsAssignedByActorIdActorProfiles")
  workRequestAuditLogsByPerformedByActorId                    WorkRequestAuditLog[]                      @relation("WorkRequestAuditLogsPerformedByActorIdActorProfiles")
  workRequestNotesByCreatedByActorId                          WorkRequestNote[]                          @relation("WorkRequestNotesCreatedByActorIdActorProfiles")
  workflowInfoRequestsByRequestedByActorId                    WorkflowInfoRequest[]                      @relation("WorkflowInfoRequestsRequestedByActorIdActorProfiles")
  workflowInfoResponsesByRespondedByActorId                   WorkflowInfoResponse[]                     @relation("WorkflowInfoResponsesRespondedByActorIdActorProfiles")
  workRequestRevisionRequestsByRequestedByActorId             WorkRequestRevisionRequest[]               @relation("WorkRequestRevisionRequestsRequestedByActorIdActorProfiles")
  workRequestRevisionDocumentsByAttachedByActorId             WorkRequestRevisionDocument[]              @relation("WorkRequestRevisionDocumentsAttachedByActorIdActorProfiles")
  workRequestRevisionSubmissionsBySubmittedByActorId          WorkRequestRevisionSubmission[]            @relation("WorkRequestRevisionSubmissionsSubmittedByActorIdActorProfiles")
  workRequestDecisionsByDecidedByActorId                      WorkRequestDecision[]                      @relation("WorkRequestDecisionsDecidedByActorIdActorProfiles")
  registryDocumentsByListedByActorId                          RegistryDocument[]                         @relation("RegistryDocumentsListedByActorIdActorProfiles")
  registryDocumentsByRemovedByActorId                         RegistryDocument[]                         @relation("RegistryDocumentsRemovedByActorIdActorProfiles")
  notificationsByTriggeredByActorId                           Notification[]                             @relation("NotificationsTriggeredByActorIdActorProfiles")
  notificationRecipientsByActorId                             NotificationRecipient[]                    @relation("NotificationRecipientsActorIdActorProfiles")
  systemAuditLogsByPerformedByActorId                         SystemAuditLog[]                           @relation("SystemAuditLogsPerformedByActorIdActorProfiles")
  outboxMessagesByActorId                                     OutboxMessage[]                            @relation("OutboxMessagesActorIdActorProfiles")

  @@unique([id, tenantId])
  @@index([memberId, tenantId])
  @@index([clientContactId, tenantId])
  @@index([tenantId])
  @@map("actor_profiles")
}

model AuthSession {
  tenantId                 String    @map("tenant_id") @db.Uuid
  id                       String    @id @map("id") @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @map("refresh_token_hash") @db.VarChar(255)
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") @db.VarChar(255)
  ipAddress                String?   @map("ip_address") @db.VarChar(80)
  userAgent                String?   @map("user_agent") @db.Text
  expiresAt                DateTime  @map("expires_at") @db.Timestamp(6)
  absoluteExpiresAt        DateTime  @map("absolute_expires_at") @db.Timestamp(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant                Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                  User                              @relation("AuthSessionsUserIdUsers", fields: [userId], references: [id])
  consumedRefreshTokens AuthSessionConsumedRefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@index([previousRefreshTokenHash])
  @@index([tenantId])
  @@map("auth_sessions")
}

model AuthSessionConsumedRefreshToken {
  tenantId   String   @map("tenant_id") @db.Uuid
  id         String   @id @map("id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  tokenHash  String   @map("token_hash") @db.VarChar(255)
  consumedAt DateTime @default(now()) @map("consumed_at") @db.Timestamp(6)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tokenHash])
  @@index([sessionId])
  @@index([tenantId])
  @@map("auth_session_consumed_refresh_tokens")
}

model PasswordResetToken {
  tenantId  String    @map("tenant_id") @db.Uuid
  id        String    @id @map("id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation("PasswordResetTokensUserIdUsers", fields: [userId], references: [id])

  @@unique([tenantId, tokenHash])
  @@index([userId])
  @@index([tenantId])
  @@map("password_reset_tokens")
}

model CompanyType {
  id          String  @id @map("id") @db.Uuid
  name        String  @unique @map("name") @db.VarChar(100)
  description String? @map("description") @db.Text

  companiesByCompanyTypeId Company[] @relation("CompaniesCompanyTypeIdCompanyTypes")

  @@map("company_types")
}

model Company {
