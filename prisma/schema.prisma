/// A durable record for a Bid binary that was written to protected local
/// storage but could not be deleted after the enclosing Bid transaction failed.
/// It deliberately has no Bid FK: a cleanup job exists precisely when no Bid
/// document must be allowed to claim the orphaned object.
model BidStorageCleanupJob {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @id @map("id") @db.Uuid
  storageKey      String   @map("storage_key") @db.Text
  attempts        Int      @default(1) @map("attempts")
  lastError       String   @map("last_error") @db.Text
  lastAttemptedAt DateTime @default(now()) @map("last_attempted_at") @db.Timestamp(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, storageKey])
  @@index([createdAt])
  @@index([tenantId])
  @@map("bid_storage_cleanup_jobs")
}

/// An orphaned direct Project binary is never a Project document.  This queue
/// records only failed compensation after a Project transaction rolls back.
model DirectProjectStorageCleanupJob {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @id @map("id") @db.Uuid
  storageKey      String   @map("storage_key") @db.Text
  attempts        Int      @default(1) @map("attempts")
  lastError       String   @map("last_error") @db.Text
  lastAttemptedAt DateTime @default(now()) @map("last_attempted_at") @db.Timestamp(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, storageKey])
  @@index([createdAt])
  @@index([tenantId])
  @@map("direct_project_storage_cleanup_jobs")
}

/// A Work Request orphan is recorded only when storage compensation fails after
/// its owning transaction rolls back; it deliberately has no Work Request FK.
model WorkRequestStorageCleanupJob {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @id @map("id") @db.Uuid
  storageKey      String   @map("storage_key") @db.Text
  attempts        Int      @default(1) @map("attempts")
  lastError       String   @map("last_error") @db.Text
  lastAttemptedAt DateTime @default(now()) @map("last_attempted_at") @db.Timestamp(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, storageKey])
  @@index([createdAt])
  @@index([tenantId])
  @@map("work_request_storage_cleanup_jobs")
}
