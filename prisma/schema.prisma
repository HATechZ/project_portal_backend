  workRequestDecisionsByDecisionResultId WorkRequestDecision[] @relation("WorkRequestDecisionsDecisionResultIdDecisionResults")

  @@map("decision_results")
}

model WorkRequestDecision {
  tenantId         String   @map("tenant_id") @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id               String   @id @map("id") @db.Uuid
  workRequestId    String   @map("work_request_id") @db.Uuid
  actionId         String   @map("action_id") @db.Uuid
  decisionResultId String   @map("decision_result_id") @db.Uuid
  decidedByActorId String   @map("decided_by_actor_id") @db.Uuid
  fromStatusId     String?  @map("from_status_id") @db.Uuid
  toStatusId       String?  @map("to_status_id") @db.Uuid
  note             String?  @map("note") @db.Text
  decidedAt        DateTime @default(now()) @map("decided_at") @db.Timestamp(6)

  workRequest    WorkRequest              @relation("WorkRequestDecisionsWorkRequestIdWorkRequests", fields: [workRequestId], references: [id])
  action         WorkflowActionDefinition @relation("WorkRequestDecisionsActionIdWorkflowActionDefinitions", fields: [actionId], references: [id])
  decisionResult DecisionResult           @relation("WorkRequestDecisionsDecisionResultIdDecisionResults", fields: [decisionResultId], references: [id])
  decidedByActor ActorProfile             @relation("WorkRequestDecisionsDecidedByActorIdActorProfiles", fields: [decidedByActorId], references: [id])
  fromStatus     WorkflowStatus?          @relation("WorkRequestDecisionsFromStatusIdWorkflowStatuses", fields: [fromStatusId], references: [id])
  toStatus       WorkflowStatus?          @relation("WorkRequestDecisionsToStatusIdWorkflowStatuses", fields: [toStatusId], references: [id])

  @@index([workRequestId, decidedAt])
  @@index([decisionResultId])
  @@index([tenantId])
  @@map("work_request_decisions")
}

model RegistryDocument {
  tenantId                String    @map("tenant_id") @db.Uuid
