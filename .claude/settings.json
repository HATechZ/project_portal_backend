{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/verify-sdd.mjs --hook",
            "timeout": 30,
            "statusMessage": "Checking SDD Gate 5..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/db-prompt-guard.mjs",
            "timeout": 10,
            "statusMessage": "Checking for DB-architecture routing..."
          }
        ]
      }
    ]
  }
}
